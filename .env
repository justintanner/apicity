# Apicity environment.
#
# Secret values resolve from the Apicity 1Password vault. Use this file with:
#   op run --env-file=.env -- <command>

# Core AI providers
OPENAI_API_KEY=op://Apicity/OPENAI_API_KEY/password
KIE_API_KEY=op://Apicity/KIE_API_KEY/password
