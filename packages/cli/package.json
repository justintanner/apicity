{
  "name": "@apicity/cli",
  "version": "0.12.1",
  "description": "Command-line interface and agent skill for every @apicity provider endpoint.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justintanner/apicity.git",
    "directory": "cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "apicity": "dist/src/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "ai",
    "cli",
    "agent-skills",
    "claude-code",
    "codex",
    "apicity",
    "openai",
    "anthropic",
    "xai",
    "fal",
    "kie",
    "fireworks"
  ],
  "author": "Justin Tanner",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/dist.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@apicity/alibaba": "workspace:*",
    "@apicity/anthropic": "workspace:*",
    "@apicity/b2": "workspace:*",
    "@apicity/binance": "workspace:*",
    "@apicity/cost": "workspace:*",
    "@apicity/dolthub": "workspace:*",
    "@apicity/dropbox": "workspace:*",
    "@apicity/elevenlabs": "workspace:*",
    "@apicity/fal": "workspace:*",
    "@apicity/fireworks": "workspace:*",
    "@apicity/free-media-upload": "workspace:*",
    "@apicity/google": "workspace:*",
    "@apicity/googleflow": "workspace:*",
    "@apicity/meta": "workspace:*",
    "@apicity/kie": "workspace:*",
    "@apicity/kimicoding": "workspace:*",
    "@apicity/openf1": "workspace:*",
    "@apicity/openligadb": "workspace:*",
    "@apicity/openai": "workspace:*",
    "@apicity/polymarket": "workspace:*",
    "@apicity/quo": "workspace:*",
    "@apicity/s3": "workspace:*",
    "@apicity/simplefunctions": "workspace:*",
    "@apicity/telegram": "workspace:*",
    "@apicity/thesportsdb": "workspace:*",
    "@apicity/x": "workspace:*",
    "@apicity/xai": "workspace:*",
    "@apicity/youtube": "workspace:*",
    "@apicity/zaicoding": "workspace:*"
  },
  "homepage": "https://github.com/justintanner/apicity#readme",
  "bugs": {
    "url": "https://github.com/justintanner/apicity/issues"
  }
}
