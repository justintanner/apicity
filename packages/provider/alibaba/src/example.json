{
  "GET api.v1.uploads": {
    "source": "alibaba/uploads-policy",
    "payload": {
      "action": "getPolicy",
      "model": "qwen-image-edit"
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST api.v1.services.aigc.imageGeneration.generation": {
    "source": "alibaba/wan-image-t2i",
    "payload": {
      "model": "wan2.7-image-pro",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "text": "A flower shop with exquisite windows, a beautiful wooden door, and flowers on display"
              }
            ]
          }
        ]
      },
      "parameters": {
        "size": "2K",
        "n": 1,
        "watermark": false,
        "thinking_mode": true
      }
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST api.v1.services.aigc.multimodalGeneration.generation": {
    "source": "alibaba/qwen-image-edit-single",
    "payload": {
      "model": "qwen-image-edit",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": [
              {
                "image": "https://help-static-aliyun-doc.aliyuncs.com/file-manage-files/zh-CN/20250925/fpakfo/image36.webp"
              },
              {
                "text": "Add a small red bird perched on the bicycle seat."
              }
            ]
          }
        ]
      }
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST api.v1.services.aigc.videoGeneration.videoSynthesis": {
    "source": "alibaba/wan-3-0-video",
    "payload": {
      "model": "wan3.0-video",
      "input": {
        "prompt": "A red cube slowly rotates on a white table"
      },
      "parameters": {
        "resolution": "480P",
        "duration": 2
      }
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST compatibleMode.v1.chat.completions": {
    "source": "alibaba/chat-hello",
    "payload": {
      "model": "qwen3-max",
      "messages": [
        {
          "role": "user",
          "content": "Say hello in one sentence."
        }
      ],
      "temperature": 0,
      "max_tokens": 64
    },
    "tier": "expensive",
    "runByDefault": false
  }
}
