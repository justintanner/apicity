{
  "POST v1.projects.locations.global.interactions": {
    "source": "google/omni-1-2-flash-t2v",
    "payload": {
      "model": "gemini-omni-1.2-flash",
      "input": [
        {
          "type": "user_input",
          "content": [
            {
              "type": "text",
              "text": "A red paper boat drifts slowly across a still pond."
            }
          ]
        }
      ],
      "response_format": [
        {
          "type": "video",
          "aspect_ratio": "16:9",
          "delivery": "inline",
          "duration": "3s",
          "resolution": "360p"
        }
      ],
      "store": false
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST v1.projects.locations.global.publishers.google.models.generateContent": {
    "source": "google/nano-banana-2-1",
    "payload": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "A single red origami crane centered on plain white paper."
            }
          ]
        }
      ],
      "generationConfig": {
        "responseModalities": [
          "IMAGE"
        ],
        "imageConfig": {
          "aspectRatio": "1:1",
          "imageSize": "1K"
        }
      }
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST v1.publishers.google.models.countTokens": {
    "source": "google/count-tokens",
    "payload": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Count the tokens in this short prompt."
            }
          ]
        }
      ]
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST v1.publishers.google.models.generateContent": {
    "source": "google/generate-content",
    "payload": {
      "contents": [
        {
          "role": "user",
          "parts": [
            {
              "text": "Say hello in one short sentence."
            }
          ]
        }
      ],
      "generationConfig": {
        "temperature": 0,
        "thinkingConfig": {
          "thinkingBudget": 0
        },
        "maxOutputTokens": 32
      }
    },
    "tier": "expensive",
    "runByDefault": false
  },
  "POST v1internal.retrieveUserQuota": {
    "source": "google/antigravity-usage",
    "payload": {},
    "tier": "expensive",
    "runByDefault": false
  }
}
