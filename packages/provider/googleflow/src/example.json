{
  "GET v1.accounts.captchaStats": {
    "source": "google-flow/contracts",
    "payload": {
      "date": "2026-06-25",
      "limit": 10,
      "anonymized": true
    }
  },
  "GET v1.characters": {
    "source": "google-flow/contracts",
    "payload": {
      "email": "user@example.com"
    }
  },
  "GET v1.jobs": {
    "source": "google-flow/contracts",
    "payload": {
      "options": "history"
    }
  },
  "GET v1.voices": {
    "source": "google-flow/contracts",
    "payload": {
      "email": "user@example.com",
      "source": "user"
    }
  },
  "POST v1.accounts": {
    "source": "google-flow/contracts",
    "payload": {
      "cookies": "SID=fixture;"
    }
  },
  "POST v1.accounts.captchaProviders": {
    "source": "google-flow/contracts",
    "payload": {
      "CapSolver": "provider-key"
    }
  },
  "POST v1.characters": {
    "source": "google-flow/contracts",
    "payload": {
      "displayName": "Ari",
      "imageReference_1": "media-1"
    }
  },
  "POST v1.images": {
    "source": "google-flow/contracts",
    "payload": {
      "prompt": "A clean product photo",
      "count": 1
    }
  },
  "POST v1.images.upscale": {
    "source": "google-flow/contracts",
    "payload": {
      "mediaGenerationId": "image-1",
      "resolution": "2k"
    }
  },
  "POST v1.videos": {
    "source": "google-flow/contracts",
    "payload": {
      "prompt": "A slow camera push through a studio",
      "count": 1
    }
  },
  "POST v1.videos.concatenate": {
    "source": "google-flow/contracts",
    "payload": {
      "media": [
        {
          "mediaGenerationId": "video-1",
          "trimStart": 1
        },
        {
          "mediaGenerationId": "video-2",
          "trimEnd": 1
        }
      ]
    }
  },
  "POST v1.videos.extend": {
    "source": "google-flow/contracts",
    "payload": {
      "mediaGenerationId": "video-1",
      "prompt": "Continue the motion"
    }
  },
  "POST v1.videos.gif": {
    "source": "google-flow/contracts",
    "payload": {
      "mediaGenerationId": "video-1"
    }
  },
  "POST v1.videos.upscale": {
    "source": "google-flow/contracts",
    "payload": {
      "mediaGenerationId": "video-1",
      "resolution": "1080p"
    }
  },
  "POST v1.voices": {
    "source": "google-flow/contracts",
    "payload": {
      "email": "user@example.com",
      "voice": "Aoede",
      "displayName": "Narrator",
      "dialog": "Hello there",
      "voicePerformance": "Warm and clear"
    }
  }
}
