{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/build",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowJs": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "src/**/*.mjs"]
}
