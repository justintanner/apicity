{
  "POST v1.alibaba.services.aigc.videoGeneration.videoSynthesis": {
    "source": "nunchux/wan-3-0-text-to-video",
    "payload": {
      "model": "wan3.0-video",
      "input": {
        "prompt": "A red paper boat drifts across a calm pond at sunrise."
      },
      "parameters": {
        "resolution": "480P",
        "duration": 2,
        "watermark": false
      }
    },
    "tier": "prohibitive",
    "runByDefault": false
  },
  "POST v1.bytedance.contents.generations.tasks": {
    "source": "nunchux/seedance-2-5-text-to-video",
    "payload": {
      "model": "dreamina-seedance-2-5-260628",
      "content": [
        {
          "type": "text",
          "text": "A red paper boat drifts across a calm pond at sunrise; slow push-in."
        }
      ],
      "duration": 4,
      "resolution": "480p",
      "generate_audio": false
    },
    "tier": "prohibitive",
    "runByDefault": false
  },
  "POST v1.google.v1beta.interactions": {
    "source": "nunchux/nano-banana-2-1-text-to-image",
    "payload": {
      "model": "gemini-nano-banana-2.1",
      "input": [
        {
          "type": "text",
          "text": "A red paper boat on a calm pond at sunrise, soft morning light, photographic."
        }
      ],
      "response_format": {
        "type": "image",
        "image_size": "1K",
        "aspect_ratio": "1:1"
      }
    },
    "tier": "prohibitive",
    "runByDefault": false
  },
  "POST v1.minimax.v2.videoGeneration": {
    "source": "nunchux/minimax-h3-text-to-video",
    "payload": {
      "model": "MiniMax-H3",
      "content": [
        {
          "type": "text",
          "text": "A red paper boat drifts across a calm pond at sunrise; slow push-in."
        }
      ],
      "resolution": "768P",
      "duration": 4,
      "ratio": "16:9"
    },
    "tier": "prohibitive",
    "runByDefault": false
  },
  "POST v2.openai.images.generations": {
    "source": "nunchux/gpt-image-2-6-flare-text-to-image",
    "payload": {
      "model": "gpt-image-2.6-flare",
      "prompt": "a red paper lantern",
      "size": "1024x1024",
      "quality": "low"
    },
    "tier": "prohibitive",
    "runByDefault": false
  }
}
