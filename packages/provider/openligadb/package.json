{
  "name": "@apicity/openligadb",
  "version": "0.10.2",
  "description": "OpenLigaDB API provider for public soccer match data, metadata, standings, and scorers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justintanner/apicity.git",
    "directory": "provider/openligadb"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./zod": {
      "import": "./dist/src/zod.js",
      "types": "./dist/src/zod.d.ts"
    }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "openligadb",
    "sports",
    "soccer",
    "football",
    "bundesliga",
    "match-data",
    "standings",
    "scorers",
    "apicity"
  ],
  "author": "Justin Tanner",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/dist.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://github.com/justintanner/apicity#readme",
  "bugs": {
    "url": "https://github.com/justintanner/apicity/issues"
  }
}
