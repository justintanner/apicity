{
  "name": "@apicity/telegram",
  "version": "0.5.4",
  "description": "Telegram Bot API provider for sending messages, media, polls, and rich messages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justintanner/apicity.git",
    "directory": "provider/telegram"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./zod": {
      "import": "./dist/src/zod.js",
      "types": "./dist/src/zod.d.ts"
    }
  },
  "dependencies": {
    "zod": "^3.24.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "telegram",
    "telegram-bot-api",
    "bot",
    "messages",
    "apicity"
  ],
  "author": "Justin Tanner",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/dist.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "homepage": "https://github.com/justintanner/apicity#readme",
  "bugs": {
    "url": "https://github.com/justintanner/apicity/issues"
  }
}
