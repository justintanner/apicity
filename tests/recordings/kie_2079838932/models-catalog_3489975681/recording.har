            "mimeType": "application/json;charset=UTF-8",
            "size": 98532,
            "text": "{\"code\":200,\"msg\":\"success\",\"data\":{\"total\":218,\"models\":[{\"model\":\"kling/v2-1-master-text-to-video\",\"slug\":\"kling/v2-1-master-text-to-video\",\"title\":\"Affordable Kling 2.1 Master API — Premium Text-to-Video Generation\",\"provider\":\"Kling\",\"taskType\":[\"Text to Video\"],\"description\":\"Kling 2.1 Master API is the premium endpoint of the Kling 2.1 model developed by Kuaishou. It enables text-to-video and image-to-video generation with cinematic quality, motion fluidity, and prompt precision in 1080p resolution.\",\"pricingDesc\":\"A 5-second video costs 160 credits ($0.80), and a 10-second video costs 320 credits ($1.60).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.72 for a 5-second video and ~$1.44 for a 10-second video.\"},{\"model\":\"kling/v2-1-master-image-to-video\",\"slug\":\"kling/v2-1-master-image-to-video\",\"title\":\"Kling v2.1 Master API: AI Image to Video API\",\"provider\":\"Kling\",\"taskType\":[\"Image to Video\"],\"description\":\"Unleash Cinematic Magic: Turn Static Images into Dynamic Masterpieces with Kling v2.1 Master\",\"pricingDesc\":\"A 5-second video costs 160 credits ($0.80), and a 10-second video costs 320 credits ($1.60).\\n High-tier top-ups (+10% bonus) bring effective pricing down to ~$0.73 per 5-second video and ~$1.45 per 10-second video.\"},{\"model\":\"kling/v2-1-pro\",\"slug\":\"kling/v2-1-pro\",\"title\":\"Affordable Kling 2.1 Pro API: Professional Image-to-Video Generation\",\"provider\":\"Kling\",\"taskType\":[\"Image to Video\"],\"description\":\"The Kling 2.1 Pro is the latest model in the Kling AI series, specializing in image-to-video generation. With enhanced motion simulation, high-quality 1080p output, and improved semantic understanding, it is perfect for professional video production.\",\"pricingDesc\":\"A 5-second video costs 50 credits ($0.25), and a 10-second video costs 100 credits ($0.5).\\n High-tier top-ups (+10% bonus) bring effective pricing down to ~$0.23 per 5-second video and ~$0.45 per 10-second video.\"},{\"model\":\"kling/v2-1-standard\",\"slug\":\"kling/v2-1-standard\",\"title\":\"Kling 2.1 Standard API: Cost-Effective Image to Video Generation\",\"provider\":\"Kling\",\"taskType\":[\"Image to Video\"],\"description\":\"Kling 2.1 Standard is a high-performance image-to-video model from Kling AI (Kuaishou), offering fast, cinematic AI video generation with 720P quality for creators and developers.\",\"pricingDesc\":\"A 5-second video costs 25 credits ($0.125), and a 10-second video costs 50 credits ($0.25).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.11 for a 5-second video and ~$0.23 for a 10-second video.\"},{\"model\":\"bytedance/v1-pro-image-to-video\",\"slug\":\"bytedance/v1-pro-image-to-video\",\"title\":\"Seedance 1.0 Pro-Image to Video\",\"provider\":\"ByteDance\",\"taskType\":[\"Image to Video\"],\"description\":\"Seedance 1.0 Pro is an advanced AI model developed by ByteDance, designed to generate high-quality videos from both images and text. It excels in 1080p resolution, providing seamless multi-shot transitions and cinematic motion for creating professional-grade content.\",\"pricingDesc\":\"For Seedance V1 Pro, generating 1 second of video costs about 2.8 credits ($0.014) at 480p, 6 credits ($0.030) at 720p, and 14 credits ($0.070) at 1080p.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.013/s at 480p, ~$0.027/s at 720p, and ~$0.063/s at 1080p.\"},{\"model\":\"bytedance/v1-pro-text-to-video\",\"slug\":\"bytedance/v1-pro-text-to-video\",\"title\":\"Seedance 1.0 Pro-Text to Video\",\"provider\":\"ByteDance\",\"taskType\":[\"Text to Video\"],\"description\":\"Seedance 1.0 Pro, developed by Bytedance, is a powerful tool that transforms text and images into high-quality videos. With resolutions up to 1080p and multi-shot capabilities, it enables creators to produce cinematic, narrative-driven content with smooth transitions and exceptional visual clarity.\",\"pricingDesc\":\"For Seedance V1 Pro, generating 1 second of video costs about 2.8 credits ($0.014) at 480p, 6 credits ($0.030) at 720p, and 14 credits ($0.070) at 1080p.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.013/s at 480p, ~$0.027/s at 720p, and ~$0.063/s at 1080p.\"},{\"model\":\"bytedance/v1-lite-image-to-video\",\"slug\":\"bytedance/v1-lite-image-to-video\",\"title\":\"Seedance 1.0 Lite Image to Video\",\"provider\":\"ByteDance\",\"taskType\":[\"Image to Video\"],\"description\":\"Animate Your Images: Seedance 1.0 Lite API Revives Stills into Vivid Videos Seamlessly.\",\"pricingDesc\":\"For Seedance V1 Lite, generating 1 second of video costs about 2 credits ($0.010) at 480p, 4.5 credits ($0.0225) at 720p, and 10 credits ($0.050) at 1080p.\"},{\"model\":\"bytedance/v1-lite-text-to-video\",\"slug\":\"bytedance/v1-lite-text-to-video\",\"title\":\"Seedance 1.0 Lite Text to Video\",\"provider\":\"ByteDance\",\"taskType\":[\"Text to Video\"],\"description\":\"From Words to Wonders: Seedance 1.0 Lite API Brings Your Ideas to Life in Video Form.\",\"pricingDesc\":\"For Seedance V1 Lite, generating 1 second of video costs about 2 credits ($0.010) at 480p, 4.5 credits ($0.0225) at 720p, and 10 credits ($0.050) at 1080p.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.009/s at 480p, ~$0.020/s at 720p, and ~$0.045/s at 1080p.\"},{\"model\":\"ideogram/v3-text-to-image\",\"slug\":\"ideogram/v3-text-to-image\",\"title\":\"Ideogram V3 Text to Image\",\"provider\":\"Ideogram\",\"taskType\":[\"Text to Video\"],\"description\":\"Ideogram V3 API is a new text-to-image model from Ideogram, featuring improved realism, style control, and precise text rendering. It supports Turbo, Default, and Quality modes to suit different creative needs.\",\"pricingDesc\":\"Ideogram V3 costs 3.5 credits ($0.0175) for Turbo, 7 credits ($0.035) for Balanced, or 10 credits (~$0.05) for Quality per image.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.016 for Turbo, ~$0.032 for Balanced, and ~$0.045 for Quality per image.\"},{\"model\":\"ideogram/v3-edit\",\"slug\":\"ideogram/v3-edit\",\"title\":\"Ideogram V3 Edit Image-Image to Image\",\"provider\":\"Ideogram\",\"taskType\":[\"Image Editing\"],\"description\":\"Ideogram V3 Edit API on Kie.ai enables precise mask-based image editing, letting you change selected areas while keeping the rest untouched. Ideal for background replacement, object edits, and detail enhancements with flexible rendering and style options.\",\"pricingDesc\":\"Ideogram V3 costs 3.5 credits ($0.0175) for Turbo, 7 credits ($0.035) for Balanced, or 10 credits (~$0.05) for Quality per image.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.016 for Turbo, ~$0.032 for Balanced, and ~$0.045 for Quality per image.\"},{\"model\":\"ideogram/v3-remix\",\"slug\":\"ideogram/v3-remix\",\"title\":\"Ideogram V3 Remix\",\"provider\":\"Ideogram\",\"taskType\":[\"Image Editing\"],\"description\":\"Ideogram 3.0 Remix is an advanced image-to-image AI model designed for prompt-based visual transformation, enabling users to generate new variations from existing images with high fidelity.  \",\"pricingDesc\":null},{\"model\":\"wan/2-2-a14b-text-to-video-turbo\",\"slug\":\"wan/2-2-a14b-text-to-video-turbo\",\"title\":\"Wan 2.2 A14B Text to Video Turbo\",\"provider\":\"Wan\",\"taskType\":[\"Text to Video\"],\"description\":\"Wan-2.2 Text-to-Video A14B Turbo is an advanced AI video model that transforms text prompts into high-quality cinematic clips with smooth motion, rich details, and accurate scene alignment. Designed for developers and creators, it delivers 720p videos at 24 fps with fast rendering and strong motion diversity.\",\"pricingDesc\":\"wan v2.2-a14b turbo costs 16 credits per video second for 720p ($0.08), 12 credits per video for 580p ($0.06), 8 credits per video for 480p ($0.04)\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.073 per second (720p), ~$0.055 per video (580p), and ~$0.036 per video (480p).\"},{\"model\":\"wan/2-2-a14b-image-to-video-turbo\",\"slug\":\"wan/2-2-a14b-image-to-video-turbo\",\"title\":\"Wan 2.2 A14B Image to Video Turbo\",\"provider\":\"Wan\",\"taskType\":[\"Image to Video\"],\"description\":\"Wan 2.2 A14B Turbo image-to-video is a fast AI model that generates smooth, cinematic videos from still images, with consistent motion and preserved style.\",\"pricingDesc\":\"wan v2.2-a14b turbo costs 16 credits per video second for 720p ($0.08), 12 credits per video for 580p ($0.06), 8 credits per video for 480p ($0.04)\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.073 per second (720p), ~$0.055 per video (580p), and ~$0.036 per video (480p).\"},{\"model\":\"google/imagen4\",\"slug\":\"google/imagen4\",\"title\":\"Google Imagen 4-Text to Image\",\"provider\":\"Google\",\"taskType\":[\"Text to Image\"],\"description\":\"Google Imagen 4, developed by Google DeepMind and released at Google I/O 2025, is an advanced text-to-image generation model. It converts textual prompts into photorealistic, high-quality images with exceptional detail, clarity, and artistic versatility, making it perfect for both creative and commercial use.\",\"pricingDesc\":\"Imagen 4 costs 8 credits per image ($0.04).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.036 per image.\"},{\"model\":\"google/imagen4-ultra\",\"slug\":\"google/imagen4-ultra\",\"title\":\"Google Imagen 4 Ultra-Text to Image\",\"provider\":\"Google\",\"taskType\":[\"Text to Image\"],\"description\":\"Google Imagen 4 Ultra is the latest breakthrough in text-to-image generation, offering unmatched precision, speed, and photorealistic quality. Developed by Google DeepMind, this model transforms detailed text prompts into high-resolution, lifelike images, making it ideal for marketing, design, and creative applications.\",\"pricingDesc\":\"Imagen 4 Ultra costs 12 credits per image ($0.06).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.055 per image.\"},{\"model\":\"qwen/image-edit\",\"slug\":\"qwen/image-edit\",\"title\":\"Qwen Image Edit\",\"provider\":\"Qwen\",\"taskType\":[\"Image to Image\"],\"description\":\"Qwen-Image-Edit is an open-source image editing model based on Qwen-Image, supporting semantic and appearance editing with precise, visually coherent results. It also handles bilingual (Chinese and English) text editing while preserving font, size, and style, making it a versatile tool for advanced visual content manipulation.\",\"pricingDesc\":\"Price ≈ $0.03 per megapixel, depending on the image aspect ratio. For detailed comparisons, please refer to the README.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ≈ $0.027 per megapixel.\"},{\"model\":\"ideogram/character\",\"slug\":\"ideogram/character\",\"title\":\"Ideogram Character Base\",\"provider\":\"Ideogram\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Ideogram Character costs 12 credits ($0.06) Turbo, 18 credits ($0.09) Balanced, 24 credits ($0.12) Quality.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.055 (Turbo), ~$0.082 (Balanced), and ~$0.109 (Quality).\"},{\"model\":\"ideogram/character-edit\",\"slug\":\"ideogram/character-edit\",\"title\":\"ideogram character edit\",\"provider\":\"Ideogram\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Ideogram Character costs 12 credits ($0.06) Turbo, 18 credits ($0.09) Balanced, 24 credits ($0.12) Quality.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.055 (Turbo), ~$0.082 (Balanced), and ~$0.109 (Quality).\"},{\"model\":\"ideogram/character-remix\",\"slug\":\"ideogram/character-remix\",\"title\":\"ideogram character remix\",\"provider\":\"Ideogram\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Ideogram Character costs 12 credits ($0.06) Turbo, 18 credits ($0.09) Balanced, 24 credits ($0.12) Quality.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.055 (Turbo), ~$0.082 (Balanced), and ~$0.109 (Quality).\"},{\"model\":\"runway\",\"slug\":\"runway\",\"title\":\"Runway API\",\"provider\":\"Runway\",\"taskType\":[\"Text to Video\",\"Image to Video\"],\"description\":\"Empower Your Vision: Runway API Unleashes Cinematic AI on Kie.ai\",\"pricingDesc\":\"5s at 720p costs 12 credits per video (≈ $0.06), while 10s at 720p or 5s at 1080p cost 30 credits per video (≈ $0.15).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ≈ $0.055 (5s 720p) and ≈ $0.136 (10s 720p / 5s 1080p).\"},{\"model\":\"google/imagen4-fast\",\"slug\":\"google/imagen4-fast\",\"title\":\"Imagen 4 Fast-Text to Image\",\"provider\":\"Google\",\"taskType\":[\"Text to Image\"],\"description\":null,\"pricingDesc\":\"Imagen 4 Fast costs 4 credits per image (≈ $0.020).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ≈ $0.018 per image.\"},{\"model\":\"google/nano-banana\",\"slug\":\"google/nano-banana\",\"title\":\"Nano Banana-Gemini 2.5 Flash Image(Text to Image)\",\"provider\":\"Google\",\"taskType\":[\"Text to Image\"],\"description\":null,\"pricingDesc\":\"Nano Banana API costs 4 credits per image (~$0.02).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.018 per image.\"},{\"model\":\"google/nano-banana-edit\",\"slug\":\"google/nano-banana-edit\",\"title\":\"Nano Banana-Gemini 2.5 Flash Image-Image to Image\",\"provider\":\"Google\",\"taskType\":[\"Image to Image\"],\"description\":\"Convert image into short visual image outputs with coherent motion using the specific nano banana image-editing model.\",\"pricingDesc\":\"Nano Banana API costs 4 credits per image (~$0.02).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.018 per image.\"},{\"model\":\"qwen/text-to-image\",\"slug\":\"qwen/text-to-image\",\"title\":\"Qwen - Text to Image\",\"provider\":\"Qwen\",\"taskType\":[\"Text to Image\"],\"description\":null,\"pricingDesc\":\"Qwen Image is priced at 4 credits per megapixel (≈ $0.02).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.018 per megapixel.\"},{\"model\":\"qwen/image-to-image\",\"slug\":\"qwen/image-to-image\",\"title\":\"Qwen - Image to Image\",\"provider\":\"Qwen\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Qwen Image-to-Image costs 4 credits per image (= $0.02).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.018 per image.\"},{\"model\":\"wan/2-2-a14b-speech-to-video-turbo\",\"slug\":\"wan/2-2-a14b-speech-to-video-turbo\",\"title\":\"Wan 2.2 A14B Speech to Video Turbo\",\"provider\":\"Wan\",\"taskType\":[\"Speech to Video\"],\"description\":\"Wan 2.2 A14B Turbo API Speech to Video, this revolutionary AI model turns static images and audio clips into dynamic, expressive videos, perfect for creators, marketers, and educators. Available now on Kie.ai, experience seamless integration and unparalleled quality in video generation.\",\"pricingDesc\":\"WAN 2.2 Speech-to-Video：720 p 24 credits ($0.12)／s，580 p 18 credits ($0.09)／s，480 p 12 credits ($0.06)／s。\"},{\"model\":\"bytedance/seedream\",\"slug\":\"bytedance/seedream\",\"title\":\"Seedream V3\",\"provider\":\"ByteDance\",\"taskType\":[\"Text to Image\"],\"description\":\"Seedream 3.0 API is ByteDance’s latest text-to-image API, built for native 2K resolution, faster generation, and precise bilingual text rendering. Compared to Seedream 2.0, the Seedream v3 API delivers higher fidelity, cinematic aesthetics, and designer-level typography.\",\"pricingDesc\":\"Seedream V3 costs 3.5 credits per image ($0.0175).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0158 per image.\"},{\"model\":\"elevenlabs/text-to-speech-multilingual-v2\",\"slug\":\"elevenlabs/text-to-speech-multilingual-v2\",\"title\":\"Elevenlabs Text to Speech Multilingual V2\",\"provider\":\"Elevenlabs\",\"taskType\":[\"Text to Speech\"],\"description\":null,\"pricingDesc\":\"ElevenLabs TTS Multilingual V2: 12 credits per 1,000 characters (≈ $0.06).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per 1,000 characters.\"},{\"model\":\"elevenlabs/text-to-speech-turbo-2-5\",\"slug\":\"elevenlabs/text-to-speech-turbo-2-5\",\"title\":\"Elevenlabs Text to Speech Turbo V2.5\",\"provider\":\"Elevenlabs\",\"taskType\":[\"Text to Speech\"],\"description\":null,\"pricingDesc\":\"ElevenLabs TTS Turbo V2.5: 6 credits per 1,000 characters (≈ $0.03).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.027 per 1,000 characters.\"},{\"model\":\"recraft/crisp-upscale\",\"slug\":\"recraft/crisp-upscale\",\"title\":\"Recraft Crisp Upscale\",\"provider\":\"Elevenlabs\",\"taskType\":[\"Text to Image\"],\"description\":null,\"pricingDesc\":\"Recraft Crisp Upscale: 0.5 credits per upscale (~US $0.0025).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~US $0.0023 per upscale.\"},{\"model\":\"recraft/remove-background\",\"slug\":\"recraft/remove-background\",\"title\":\"Recraft Remove Background\",\"provider\":\"Elevenlabs\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Kie.ai Recraft Remove-Background: 1 credit ($0.005) per output image.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0045 per output image.\"},{\"model\":\"infinitalk/from-audio\",\"slug\":\"infinitalk/from-audio\",\"title\":\"Infinitalk\",\"provider\":\"Other\",\"taskType\":[\"Lip Sync\"],\"description\":null,\"pricingDesc\":\"Infinitalk: 3 credits/s (~$0.015) for 480P, 12 credits/s (~$0.06) for 720P, up to 15 seconds per generation.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.014/s (480P) and ~$0.055/s (720P).\"},{\"model\":\"bytedance/seedream-v4-edit\",\"slug\":\"bytedance/seedream-v4-edit\",\"title\":\"Seedream 4.0 Image to Image(Edit)\",\"provider\":\"ByteDance\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Seedream V4: 5 credits per image (~$0.025). The price is independent of image resolution and is solely determined by the final number of images returned. The number of images depends on the quantity specified in the prompt and the maximum value set by max_images, both of which jointly determine the final count.\\nHigh-tier top-ups include +10% bonus credits. Effective pricing is approximately 10% lower than the above rates.\"},{\"model\":\"bytedance/seedream-v4-text-to-image\",\"slug\":\"bytedance/seedream-v4-text-to-image\",\"title\":\"Seedream 4.0 Text to Image\",\"provider\":\"ByteDance\",\"taskType\":[\"Text to Image\"],\"description\":null,\"pricingDesc\":\"Seedream V4: 5 credits per image (~$0.025). The price is independent of image resolution and is solely determined by the final number of images returned. The number of images depends on the quantity specified in the prompt and the maximum value set by max_images, both of which jointly determine the final count.\\nHigh-tier top-ups include +10% bonus credits. Effective pricing is approximately 10% lower than the above rates.\"},{\"model\":\"topaz/video-upscale\",\"slug\":\"topaz/video-upscale\",\"title\":\"Topaz Video Upscale\",\"provider\":\"Other\",\"taskType\":[\"Video to Video\"],\"description\":null,\"pricingDesc\":\"Upscaling video with Topaz costs 8 credits ($0.04) per second for \\\"1×\\\" and \\\"2×\\\", 14 credits ($0.07) for \\\"4×\\\". \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.036 per second for \\\"1×\\\" and \\\"2×\\\" and ~$0.063 per second for \\\"4×\\\".\"},{\"model\":\"hailuo/02-image-to-video-standard\",\"slug\":\"hailuo/02-image-to-video-standard\",\"title\":\"Hailuo 02 Image to Video - Standard\",\"provider\":\"Hailuo\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Hailuo 02 standard image-to-video costs 5 credits ($0.025) per second at 768 p and 2 credits ($0.010) per second at 512 p. \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.023 per second at 768 p and ~$0.009 per second at 512 p.\"},{\"model\":\"hailuo/02-text-to-video-standard\",\"slug\":\"hailuo/02-text-to-video-standard\",\"title\":\"Hailuo 02 Text to Video - Standard\",\"provider\":\"Hailuo\",\"taskType\":[\"Text to Video\"],\"description\":null,\"pricingDesc\":\"Hailuo 02 standard text-to-video costs 5 credits ($0.025) per second at 768 p. \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.023 per second.\"},{\"model\":\"hailuo/02-image-to-video-pro\",\"slug\":\"hailuo/02-image-to-video-pro\",\"title\":\"Hailuo 02 Image to Video - Pro\",\"provider\":\"Hailuo\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Generate 1080p video from an image with Hailuo 02 Pro for 9.5 credits ($0.0475) per second. One generation yields a 6-second 1080p video — the web preview shows 5 s, but the downloaded file is 6 s. \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0478 per second.\"},{\"model\":\"hailuo/02-text-to-video-pro\",\"slug\":\"hailuo/02-text-to-video-pro\",\"title\":\"Hailuo 02 Text to Video - Pro\",\"provider\":\"Hailuo\",\"taskType\":[\"Text to Video\"],\"description\":null,\"pricingDesc\":\"Generate 1080p video from an image with Hailuo 02 Pro for 9.5 credits ($0.0475) per second. One generation yields a 6-second 1080p video — the web preview shows 5 s, but the downloaded file is 6 s. \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0428 per second.\"},{\"model\":\"wan/2-2-animate-replace\",\"slug\":\"wan/2-2-animate-replace\",\"title\":\"Wan 2.2 Animate Replace\",\"provider\":\"Wan\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Your request will cost 12.5 Kie credits per video-second for 720 p (≈ $0.0625), 9.5 Kie credits per video-second for 580 p (≈ $0.0475), and 6 Kie credits per video-second for 480 p (≈ $0.0300). Each job can be up to 30 seconds long, and these rates are about 20–25 % cheaper than the official pricing.\\nHigh-tier top-ups include +10% bonus credits. Effective pricing is approximately 10% lower than the above rates.\"},{\"model\":\"wan/2-2-animate-move\",\"slug\":\"wan/2-2-animate-move\",\"title\":\"Wan 2.2 Animate Move\",\"provider\":\"Wan\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Your request will cost 12.5 Kie credits per video-second for 720 p (≈ $0.0625), 9.5 Kie credits per video-second for 580 p (≈ $0.0475), and 6 Kie credits per video-second for 480 p (≈ $0.0300). Each job can be up to 30 seconds long, and these rates are about 20–25 % cheaper than the official pricing.\\nHigh-tier top-ups include +10% bonus credits. Effective pricing is approximately 10% lower than the above rates.\"},{\"model\":\"kling/v2-5-turbo-image-to-video-pro\",\"slug\":\"kling/v2-5-turbo-image-to-video-pro\",\"title\":\"Kling V2.5 Turbo Image To Video  Pro\",\"provider\":\"Kling\",\"taskType\":[\"Image to Video\"],\"description\":\"\",\"pricingDesc\":\"42 credits per 5s video ($0.21) and 84 credits per 10s video ($0.42). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.189 per 5s video and ~$0.378 per 10s video.\"},{\"model\":\"wan/2-5-image-to-video\",\"slug\":\"wan/2-5-image-to-video\",\"title\":\"Wan 2.5 Image To Video\",\"provider\":\"Wan\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"12 credits per second for 720p (~$0.06) and 20 credits per second for 1080p (~$0.10). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per second for 720p and ~$0.09 per second for 1080p.\"},{\"model\":\"kling/v2-5-turbo-text-to-video-pro\",\"slug\":\"kling/v2-5-turbo-text-to-video-pro\",\"title\":\"Kling V2.5 Turbo Text To Video Pro\",\"provider\":\"Kling\",\"taskType\":[\"Text to Video\"],\"description\":\"\",\"pricingDesc\":\"42 credits per 5-second video ($0.21) and 84 credits per 10-second video ($0.42).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.19 per 5-second video and ~$0.38 per 10-second video.\"},{\"model\":\"wan/2-5-text-to-video\",\"slug\":\"wan/2-5-text-to-video\",\"title\":\"Wan 2.5 Text To Video\",\"provider\":\"Wan\",\"taskType\":[\"Text to Video\"],\"description\":null,\"pricingDesc\":\"12 credits per second for 720p (~$0.06) and 20 credits per second for 1080p (~$0.10). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per second for 720p and ~$0.09 per second for 1080p.\"},{\"model\":\"topaz/image-upscale\",\"slug\":\"topaz/image-upscale\",\"title\":\"topaz Upscale Image\",\"provider\":\"Topaz\",\"taskType\":[\"Image to Image\"],\"description\":null,\"pricingDesc\":\"10 credits ($0.05) per ≤2 K image, 20 credits ($0.10) per 4 K image.\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.045 per ≤2K image, ~$0.09 per 4K image, and ~$0.18 per 8K image.\"},{\"model\":\"4o-image-api\",\"slug\":\"4o-image-api\",\"title\":\"4o Image\",\"provider\":\"OpenAI\",\"taskType\":[\"Text to Image\",\"Image to Image\"],\"description\":null,\"pricingDesc\":\"4O Image API on KIE: just 6 credits per image (~$0.03) — flat, all-inclusive pricing with no hidden parameters.High-tier top-ups (+10% bonus) bring effective pricing down to ~$0.027 per image.\"},{\"model\":\"flux1-kontext\",\"slug\":\"flux1-kontext\",\"title\":\"Flux Kontext\",\"provider\":\"Black Forest Labs\",\"taskType\":[\"Text to Image\",\"Image to Image\"],\"description\":null,\"pricingDesc\":\"Black Forest Labs FLUX.1 Kontext on Kie.ai offers text-to-image generation with two tiers — Pro mode at 5 credits per image (≈ $0.025) and Max mode at 10 credits per image (≈ $0.05). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0225 per image in Pro mode and ~$0.045 per image in Max mode.\"},{\"model\":\"veo-3-1\",\"slug\":\"veo-3-1\",\"title\":\"Veo 3.1\",\"provider\":\"Google\",\"taskType\":[\"Text to Video\",\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Lite mode (text-to-video / image-to-video/ reference-to-video): 720P — 30 credits (≈ $0.15) per video; 1080P — 35 credits (≈ $0.175) per video; 4K — 150 credits (≈ $0.75) per video.\\nFast mode (text-to-video / image-to-video / reference-to-video): 720P — 60 credits (≈ $0.30) per video; 1080P — 65 credits (≈ $0.325) per video; 4K — 180 credits (≈ $0.90) per video.\\nQuality mode (text-to-video / image-to-video): 720P — 250 credits (≈ $1.25) per video; 1080P — 255 credits (≈ $1.275) per video; 4K — 370 credits (≈ $1.85) per video.\\n\\nHigh-tier top-ups (+10% bonus) reduce the effective cost by about 10%, making pricing even lower for Lite, Fast, and Quality mode across all resolutions.\"},{\"model\":\"ai-music-api/extend\",\"slug\":\"ai-music-api/extend\",\"title\":\"Ai Music API Extend Music\",\"provider\":\"Suno\",\"taskType\":[\"Text to Music\"],\"description\":null,\"pricingDesc\":\"Extend Music costs 12 credits per request (≈ $0.06).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per request\"},{\"model\":\"ai-music-api/generate\",\"slug\":\"ai-music-api/generate\",\"title\":\"AI music generate\",\"provider\":\"Suno\",\"taskType\":[\"Text to Music\"],\"description\":null,\"pricingDesc\":\"Generate Music costs 12 credits per request (≈ $0.06). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per request.\"},{\"model\":\"ai-music-api/upload-and-extend-audio\",\"slug\":\"ai-music-api/upload-and-extend-audio\",\"title\":\"AI Music API Upload And Extend Audio\",\"provider\":\"Suno\",\"taskType\":[\"Text to Music\"],\"description\":null,\"pricingDesc\":\"Upload and Extend Audio costs 12 credits per request (≈ $0.06).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per request.\"},{\"model\":\"ai-music-api/upload-and-cover-audio\",\"slug\":\"ai-music-api/upload-and-cover-audio\",\"title\":\"Ai Music API Upload And Cover Audio\",\"provider\":\"Suno\",\"taskType\":[\"Text to Music\"],\"description\":null,\"pricingDesc\":\"Upload and Cover Audio costs 12.0 credits per request (≈ $0.06). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.054 per request.\"},{\"model\":\"ai-music-api/convert-to-wav-format\",\"slug\":\"ai-music-api/convert-to-wav-format\",\"title\":\"Ai Music API Upload And Convert to WAV Format\",\"provider\":\"Suno\",\"taskType\":[\"Audio to Audio\"],\"description\":null,\"pricingDesc\":\"Convert to WAV Format costs just 0.4 credits per request (≈ $0.002). \\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.0018 per request.\"},{\"model\":\"ai-music-api/create-music-video\",\"slug\":\"ai-music-api/create-music-video\",\"title\":\"Ai Music API Create Music Video\",\"provider\":\"Suno\",\"taskType\":[\"Text to Video\"],\"description\":null,\"pricingDesc\":\"Create Music Video costs 2 credits per request (≈ $0.01).\\nHigh-tier top-ups (+10% bonus) bring effective pricing down to ~$0.009 per request\"},{\"model\":\"hailuo/2-3-image-to-video-pro\",\"slug\":\"hailuo/2-3-image-to-video-pro\",\"title\":\"Hailuo 2.3 Image to Video - Pro\",\"provider\":\"Hailuo\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Hailuo 2.3 Image-to-Video — Standard 6s 768P 30 credits ($0.15), Standard 10s 768P 50 credits ($0.26), Standard 6s 1080P 50 credits ($0.26), Pro 6s 768P 45 credits ($0.22), Pro 10s 768P 90 credits ($0.45), Pro 6s 1080P 80 credits ($0.39) — all priced 20% lower than the official rates.\\nHigh-tier top-ups include +10% bonus credits. Effective pricing is approximately 10% lower than the above rates.\"},{\"model\":\"hailuo/2-3-image-to-video-standard\",\"slug\":\"hailuo/2-3-image-to-video-standard\",\"title\":\"Hailuo 2.3 Image to Video - Standard\",\"provider\":\"Hailuo\",\"taskType\":[\"Image to Video\"],\"description\":null,\"pricingDesc\":\"Hailuo 2.3 Image-to-Video — Standard 6s 768P 30 credits ($0.15), Standard 10s 768P 50 credits ($0.26), Standard 6s 1080P 50 credit