            "text": "{\"model\":\"MiniMax-H3-Turbo\",\"task_type\":\"R2V\",\"prompt\":\"Recreate the motion of the reference video in a sunlit park.\",\"video_config\":{\"duration_secs\":4,\"height\":480,\"audio\":false},\"src_video_urls\":[\"https://raw.githubusercontent.com/justintanner/apicity/d885599410f0a904c1d78ab74019e6a5fa97f00e/tests/fixtures/seedance-ref.mp4\"]}"
