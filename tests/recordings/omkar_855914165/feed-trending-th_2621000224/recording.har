tPDMzODczNEBfNmAxYi1eXmMxYF4tNjEwYSMvZWouMmRjX3JhLS1kMWBzcw%3D%3D&expire=1793403340&l=20261029073529E89BC7E466E5860782F9&ply_type=2&policy=2&tk=tt_chain_token&btag=e00070000\", \"https://v19-webapp-prime.tiktok.com/video/tos/alisg/tos-alisg-pve-0037c001/oQNp1AE4rKBowzAyIDpCAnO9FuixIPhic2QDfl/?a=1988&bti=ODszNWYuMDE6&bt=563&ft=-Csk_mXLPD12NTC7Xn-UxMNvWY6e3wv25rcAp&mime_type=video_mp4&rc=Mzk0ODo2ODs2MzZmOWU6ZUBpajRobXI5cnNtPDMzODczNEBfNmAxYi1eXmMxYF4tNjEwYSMvZWouMmRjX3JhLS1kMWBzcw%3D%3D&expire=1793403340&l=20261029073529E89BC7E466E5860782F9&ply_type=2&policy=2&tk=tt_chain_token&btag=e00070000\"]}], \"subtitles\": []}, \"images\": [], \"cover\": \"https://p16-common-sign.tiktokcdn.com/tos-alisg-p-0037/osFDFCnGTIwaCjX6QFiBEfKl4bfKUQAdaDRjAf~tplv-tiktokx-origin.image?dr=14575&x-expires=1793401200&x-signature=D6EfqQrbO7YEOBM9PH4BFdfDGys%3D&t=4d5b0474&ps=13740610&shp=81f88b70&shcp=43f4a2f9&idc=my2\", \"hashtags\": [{\"id\": \"229207\", \"name\": \"fyp\", \"link\": \"https://www.tiktok.com/tag/fyp\"}], \"mentions\": [], \"location\": null, \"effects\": [{\"id\": \"4517763070\", \"name\": \"2016 Mood II\", \"link\": \"https://www.tiktok.com/sticker/2016-Mood-II-4517763070\"}, {\"id\": \"2329209262\", \"name\": \"Modern Alpha Filter\", \"link\": \"https://www.tiktok.com/sticker/Modern-Alpha-Filter-2329209262\"}], \"text_stickers\": [], \"anchors\": [{\"id\": \"2329209262\", \"type\": 28, \"title\": \"Modern Alpha Filter\", \"description\": \"Effects\", \"link\": \"https://www.capcut.com\", \"icon\": \"https://p16-common-sign.tiktokcdn.com/tiktok-obj/capcut_logo_64px_bk.png~tplv-tiktokx-origin.image?dr=14566&x-expires=1793250000&x-signature=e72%2BmzrFLcJhja3SznTFgSOGRAE%3D&t=4d5b0474&ps=13740610&shp=81f88b70&shcp=9b759fb9&idc=my2\"}], \"suggested_searches\": []}, {\"id\": \"7694823545997659400\", \"link\": \"https://www.tiktok.com/@animalfollowingth/video/7694823545997659400\", \"type\": \"video\", \"description\": \"นี่คือเรื่องราวสุดซึ้งที่กำลังเป็นไวรัลในโซเชียลจีนฮะ เมื่อหญิงสาวคนหนึ่ง บังเอิญเจอกับสองแม่ลูกแมวจรจัดถนน แต่สิ่งที่ทำให้ใจฟูและน้ำตาซึมไปพร้อมๆ กัน คือพฤติกรรมของคุณแม่แมวลายที่พยายามส่งลูกน้อยให้ถึงฝั่งฝัน 😳🥹🥰 (มีคลิปเพิ่มเติมของน้อง) อาณาจักรสัตว์โลก มีม&สาระ By ตามติดชีวิตAnimal แทนที่จะวิ่งหนีคนเหมือนแมวจรทั่วไป แม่แมวตัวนี้กลับพาลูกน้อยตรงดิ่งเข้ามาหามนุษย์ แถมยังใช้ขาหน้าคอยดัน คอยเขี่ยหลังลูกเบาๆ ให้เดินเข้าไปใกล้มนุษย์มากขึ้นเรื่อยๆ 😣 พฤติกรรมแบบนี้ราวกับคุณแม่กำลังบอกลูกว่า \\\"เข้าไปอ้อนเขาเร็วลูก ไปอยู่กับมนุษย์นะ ชีวิตหนูจะได้สุขสบาย ไม่ต้องมาทนหิวทนหนาวข้างถนนเหมือนแม่\\\" 🫠 ชาวเน็ตจีนที่ได้เห็นคลิปนี้ต่างพากันคอมเมนต์ด้วยความเอ็นดู หลายคนบอกว่า \\\"แม่แมวคงประเมินแล้วว่าตัวเองอาจจะเลี้ยงลูกให้รอดไม่ไหว เลยเอามาฝากให้คนเลี้ยง\\\" บางก็บอก \\\"น้องเหมียวใส่มนุษย์เลยลูก\\\" หรือ \\\"เจอสายตาแห่งความหวังของแม่แมวแบบนี้ ใครจะใจแข็งไม่รับเลี้ยงได้ลงคอ\\\" 😖 เห็นความรักของแม่ที่ยอมเสียสละเพื่อให้ลูกได้มีชีวิตที่ดีกว่าแล้วก็อดซึ้งใจไม่ได้เลยจริงๆ ฮะ แล้วเพื่อนๆ ล่ะฮะ เคยมีประสบการณ์โดนแม่แมวคาบลูกมาทิ้งไว้หน้าบ้าน หรือโดนแมวจรเดินมาตกด้วยวิธีแปลกๆ แบบนี้บ้างไหม ลองคอมเมนต์เล่าเรื่องราว หรือเอารูปเจ้านายที่บ้านมาแชร์ให้แอดเพาและเพื่อนๆ ดูหน่อยฮะ 🥰 เรียบเรียง 🖋️ แอดเพา ที่มาของรูป 📸 Douyin : 温柔- #แมว #หมา #ทาสแมว #อาณาจักรสัตว์โลก #ตามติดชีวิตAnimal\", \"title\": null, \"language\": \"th\", \"created_at\": \"2026-10-10T00:05:32Z\", \"location_created\": null, \"is_ad\": false, \"is_pinned\": false, \"is_private\": false, \"is_ai_generated\": null, \"is_original\": false, \"is_official\": false, \"is_duet_enabled\": true, \"is_stitch_enabled\": true, \"is_share_enabled\": true, \"playlist_id\": null, \"stats\": {\"play_count\": 629600, \"like_count\": 91000, \"comment_count\": 292, \"share_count\": 10400, \"save_count\": 3927, \"repost_count\": 0}, \"author\": {\"id\": \"6833650970947650561\", \"sec_uid\": \"MS4wLjABAAAAjszqKg6rThY9jkikjoyUiFmJOSqLdVKLF77KCR68OyMH5ZGw4BCv690n_bNjj1kp\", \"username\": \"animalfollowingth\", \"nickname\": \"ตามติดชีวิตAnimal\", \"link\": \"https://www.tiktok.com/@animalfollowingth\", \"p