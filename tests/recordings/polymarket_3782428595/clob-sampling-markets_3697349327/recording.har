istry (Registraduría Nacional del Estado Civil) (https://registraduria.gov.co).\",\"market_slug\":\"will-paloma-valencia-win-the-2026-colombian-presidential-election\",\"end_date_iso\":\"2026-06-21T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x3e140cadcdda618e09c3bc308ce6fb65d4623f7477eb887ea4d03d54aa6ad700\",\"neg_risk_request_id\":\"0x129a8dff37fb185c314afadb9fb588f8c8a07538d41839af150cc3cba644cf82\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-paloma-valencia-win-the-1st-round-of-the-2026-colombian-presidential-election-eOha8FUkvxDW.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-paloma-valencia-win-the-1st-round-of-the-2026-colombian-presidential-election-eOha8FUkvxDW.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":47}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"62446510551119788095477835528576672715047217994292762496431912510269665561591\",\"outcome\":\"Yes\",\"price\":0.2735,\"winner\":false},{\"token_id\":\"85033408490054356469224638555921276992969532989623124901223739012644529258496\",\"outcome\":\"No\",\"price\":0.7265,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Global Elections\",\"World Elections\",\"Colombia\",\"World\",\"Rewards 200, 4.5, 50\",\"Colombia Election\",\"Main Election\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-11T00:23:36Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xbf63a5bf27c5afcd8220698223ddf84a0964df2303cceb4324cf784ef3014776\",\"question_id\":\"0x9909eb2a73b484ecee4d6ad32f5c054ed10136c293044944a43e0ff53563fe06\",\"question\":\"Will Ben Midgely win the 2026 Maine Governor R