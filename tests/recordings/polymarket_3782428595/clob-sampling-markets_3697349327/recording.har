lds.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/Byron_Donalds.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":2}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"91355315948352179408189202894554732372002014862665359041266415317109381420307\",\"outcome\":\"Yes\",\"price\":0.11,\"winner\":false},{\"token_id\":\"78899648244679692178614520226648487313262975020800793778253747924765737798972\",\"outcome\":\"No\",\"price\":0.89,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Celebrities\",\"President\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-05T21:56:57Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x48b0b0bca515f68fccf95af4793dbd0edbfec1f8ec6e8df2c0f69ba74f8c4722\",\"question_id\":\"0x7e95c4e517abdbaeffde2c42b79fce0234fc02f2776b25fae517bb6e0ee9f435\",\"question\":\"Trump out as President before 2027?\",\"description\":\"This market will resolve to “Yes” if Donald Trump resigns or is removed as President or otherwise ceases to be the President of the United States for any period of time by December 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to “No”.\\n\\nAn announcement of Donald Trump's resignation/removal before this market's end date will immediately resolve this market to \\\"Yes\\\", regardless of when the announced resignation/removal goes into effect.\\n\\nOnly permanent removal from office will qualify. Temporary removal (e.g. temporary invocation of the 25th Amendment under Section 3 or a Section 4 invocation not sustained by both Houses of Congress) or impeachment without removal will not count.\\n\\nA sustained invocation of the Twenty-Fifth Amendment, Section 4 (i.e., if both Houses of Congress, by two-thirds vote, uphold the Vice President and Cabinet’s determination of presidential inability) will qualify for a \\\"Yes\\\" resolution. \\n\\nThe resolution source for this market will be a consensus of credible reporting.\",\"market_slug\":\"trump-out-as-president-before-2027\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":0,\"taker_base_fee\":0,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/trump-out-as-president-by-march-31-c3SENQhH7Ao1.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/trump-out-as-president-by-march-31-c3SENQhH7Ao1.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":100}],\"min_size\":200,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"59252515735652674747158950210016502214756531287333895140318848923768750410355\",\"outcome\":\"Yes\",\"price\":0.135,\"winner\":false},{\"token_id\":\"2849827372590072151380088930233312280478318575453624773762283369907909283027\",\"outcome\":\"No\",\"price\":0.865,\"winner\":false}],\"tags\":[\"Politics\",\"Trump\",\"Elections\",\"Epstein\",\"Geopolitics\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-12T21:47:01Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xf39f1e7740f626facbf2a9ef7d961649dd051365dc49a142dd87a012d465ad0d\",\"question_id\":\"0xd146b70b85b52bf3232ac06e0a04016806c5fabaae178218332dc519b6ce8a67\",\"question\":\"Gemini 4.0 released by June 30, 2026?\",\"description\":\"This market will resolve to \\\"Yes\\\" if Google's Gemini 4.0 Flash model is made available to the general public by the listed date. Otherwise, this market will resolve to \\\"No\\\".\\n\\nFor this market to resolve to \\\"Yes,\\\" Gemini 4.0 must be launched and publicly accessible, including via open beta or open rolling waitlist signups. A closed beta or any form of private access will not suffice. The release must be clearly defined and publicly announced by Google as being accessible to the general public.\\n\\nGemini 4.0 refers to a product explicitly named Gemini 4.0 or one that is recognized as a successor to Gemini 3 similar to the progression from Gemini 2.0 to Gemini 3. Products labeled as Gemini 3.0 Flash, Gemini 2.5, or similar will not count for this market's resolution.\\n\\nThe primary resolution source for this market will be official information from Google, with additional verification from a consensus of credible reporting.\",\"market_slug\":\"gemini-4pt0-released-by-june-30-2026\",\"end_date_iso\":\"2026-06-30T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/gemini-3pt0-released-by-Jgab86ADS9yM.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/gemini-3pt0-released-by-Jgab86ADS9yM.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"85920782808284406495162722152976135502840500737877870275782958262187019650021\",\"outcome\":\"Yes\",\"price\":0.055,\"winner\":false},{\"token_id\":\"48951597902539401045209383419500607603262132310344816877872611342125394010003\",\"outcome\":\"No\",\"price\":0.945,\"winner\":false}],\"tags\":[\"AI\",\"Tech\",\"Gemini 3\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-11T22:18:27Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x9191a518df23e67546ee548029803c645f80c5e5cc8a9f247841dcd910f11975\",\"question_id\":\"0xabbcc201f8b2f82fb39df758225616a3db3cd9c6086bbaacabefce8813f820ff\",\"question\":\"Israel and Syria normalize relations by December 31, 2026?\",\"description\":\"This market will resolve to \\\"Yes\\\" if both Israel and Syria officially announce the establishment of diplomatic relations by December 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to \\\"No\\\".\\n\\nThe primary resolution source for this market will be official information from Israel and the Syria, however a consensus of credible reporting may also be used.\",\"market_slug\":\"israel-and-syria-normalize-relations-by-december-31-2026-166\",\"end_date_iso\":\"2025-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":0,\"taker_base_fee\":0,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/israel-and-syria-normalize-relations-in-2025-cTktGZLyjnB_.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/israel-and-syria-normalize-relations-in-2025-cTktGZLyjnB_.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"106383854378569763040038727158261681740086130201198677161578651498744312589763\",\"outcome\":\"Yes\",\"price\":0.145,\"winner\":false},{\"token_id\":\"10553917527871259014867933253903838134228152744058156727275127563897745134791\",\"outcome\":\"No\",\"price\":0.855,\"winner\":false}],\"tags\":[\"Syria\",\"Middle East\",\"Israel\",\"Geopolitics\",\"World\",\"Trump x al-Sharaa\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-13T16:23:44Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x7e50b661a2bedc670bcf32fc9ece12616f6fc4fba5dbe8526292bf3447374009\",\"question_id\":\"0xb4756d4c88a97988c3aa438fcec0b0b77634e7cfc85f4cbfe3db83572c976aae\",\"question\":\"Will Russia capture Kostyantynivka by December 31, 2026?\",\"description\":\"This market will resolve to “Yes” if, according to the ISW map, Russia captures the Kostyantynivka railroad station located on Pravoberezhna vulytsia by December 31, 2026 at 11:59 PM ET.\\n\\nThe railroad station will be considered captured if any part of the train station icon is shaded red on the ISW map (https://storymaps.arcgis.com/stories/36a7f6a6f5a9448496de641cf64bd375) by the resolution date. If the area is not shaded red by December 31, 2026, 11:59 PM ET, the market will resolve to “No”.\\n\\nIf Russia comes into control of this territory as a result of a negotiated settlement, this will qualify for a 'Yes' resolution, regardless of if it is shaded red in the ISW map. An announcement of a negotiated settlement which gives Russia de jure control will not qualify. Actual control must be established.\\n\\nOnce Russia captures the railroad station, any subsequent loss of control will not be considered towards the resolution of this market.\\n\\nTrain Station Location: https://polymarket-upload.s3.us-east-2.amazonaws.com/Kostyantynivka3.jpg\\n\\nTrain Station Location in Kostyantynivka: https://polymarket-upload.s3.us-east-2.amazonaws.com/Kostyantynivka2.jpg\\n\\nKostyantynivka Location: https://polymarket-upload.s3.us-east-2.amazonaws.com/Kostyantynivka1.jpg\\n\\nLocation on Google maps: https://maps.app.goo.gl/hZ6ch5jVRvkNFY317\\n\\nThe primary resolution source for this market will be the ISW Ukraine map. If the ISW map is rendered unavailable, information from DeepStateMap (https://deepstatemap.live/) may be used. If information from both the ISW and DeepStateMap are rendered permanently unavailable, a consensus of credible reporting may be used.\\n\\nNote: Any temporary glitches or errors in the map which will not be considered.\",\"market_slug\":\"will-russia-capture-kostyantynivka-by-december-31-2026-936-942-271-276-578-687\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":0,\"taker_base_fee\":0,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-russia-capture-kostyantynivka-by-38lHU3PVeM7C.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-russia-capture-kostyantynivka-by-38lHU3PVeM7C.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":5}],\"min_size\":40,\"max_spread\":5.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"83552904656813968939383082097054433404653657244784709614448703928529504455469\",\"outcome\":\"Yes\",\"price\":0.77,\"winner\":false},{\"token_id\":\"47029152085101973226255505664149277121974669906212969183902148537312535402801\",\"outcome\":\"No\",\"price\":0.23,\"winner\":false}],\"tags\":[\"Politics\",\"Ukraine\",\"Geopolitics\",\"World\",\"Russia Capture\",\"Ukraine Map\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-10T21:12:24Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x3342ecddb31d790a0aa690a12b3ef674d0c5014fcd5c3a50afb828b30f982170\",\"question_id\":\"0x73d8f8bd73fadf0f589bc4328e9687ff47304bf75347971764dee576c3e593bb\",\"question\":\"Will Click Bishop advance from the 2026 Alaska Governor primary election?\",\"description\":\"The non-partisan primary election for Governor of Alaska is scheduled to take place on August 18, 2026. The top four candidates in this election by number of votes won will advance to the general election for Governor of Alaska.\\n\\nThis market will resolve to “Yes” If the listed candidate advances from the primary to the general election for Governor of Alaska. Otherwise this market will resolve to “No”.\\n\\nIf no 2026 Alaska gubernatorial primary takes place, this market will resolve to “No.”\\n\\nThis market will resolve based on the results of the primary election for Governor of Alaska as indicated by a consensus of credible reporting. If there is ambiguity, this market will resolve based solely on the official results as reported by the government of Alaska, specifically the State of Alaska Division of Elections.\",\"market_slug\":\"will-click-bishop-advance-from-the-2026-alaska-governor-primary-election\",\"end_date_iso\":\"2026-08-18T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"114110405390454873868659664427829610261527071668980755489550066315775355281974\",\"outcome\":\"Yes\",\"price\":0.445,\"winner\":false},{\"token_id\":\"92220361290205926048905950241291689688158384629076846434379191653828218211634\",\"outcome\":\"No\",\"price\":0.555,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-11T17:50:45Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x6a9cec83f126fe719234360176ec90d6e9ddf7738dd18fc24591acfa4ffeb438\",\"question_id\":\"0x72fc269bfb93d03a156c5eb3b8ac432f06ce95efa68f76d2c102b4f7511b6101\",\"question\":\"Will Frank F. Blas Jr. win the 2026 Guam Governor Republican primary election?\",\"description\":\"This market will resolve according to the winner of the Republican Primary for Governor of Guam, scheduled to take place on August 1, 2026. Resolution will be based on the overall winner of the primary, including any potential second round or run-off.\\n\\nIf no 2026 Guam Gubernatorial Republican Primary takes place, this market will resolve to “Other.”\\n\\nThe resolution source for this market will be the first official announcement of the results from the Guam Republican Party; however, an overwhelming consensus of credible reporting may suffice.\",\"market_slug\":\"will-frank-f-blas-jr-win-the-2026-guam-governor-republican-primary-election-495\",\"end_date_iso\":\"2026-08-01T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x72fc269bfb93d03a156c5eb3b8ac432f06ce95efa68f76d2c102b4f7511b6100\",\"neg_risk_request_id\":\"0xbde207173f985ba6a4250a2e614288086cab0147f55fe7dd204a690db8e8098a\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/guam-governor-democratic-primary-winner-a7Bg063rfnia.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/guam-governor-democratic-primary-winner-a7Bg063rfnia.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"78298172603094196759720747983969683263067089881616851711638692098317616210827\",\"outcome\":\"Yes\",\"price\":0.11,\"winner\":false},{\"token_id\":\"108322799557128551277706551902450376060911637056120058762288194247437063581805\",\"outcome\":\"No\",\"price\":0.89,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\",\"Republican Primary\",\"Governor Primary\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-30T21:31:19Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x0bdbc45bf837bd4b6785a7d58750f6a9ffc46ac95fa514198bae416806b63921\",\"question_id\":\"0x34311be5a7d9a7667739116776761ccdb8803fb1f2132b6545a4504ca63cfb23\",\"question\":\"Will Rabby launch a token by December 31, 2026?\",\"description\":\"This market will resolve to “Yes” if Rabby officially launches a governance token by 11:59 PM ET on the date specified in the title. Otherwise, this market will resolve to “No”.\\n\\nThe token must be actively and publicly transferable and tradable. Announcements alone do not qualify.\\n\\nThe primary resolution source for this market will be information from Rabby, however a consensus of credible reporting will also be used.\",\"market_slug\":\"will-rabby-launch-a-token-by-december-31-2026\",\"end_date_iso\":\"2027-01-01T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-rabby-launch-a-token-in-2025-ThrEF3vsCsD0.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-rabby-launch-a-token-in-2025-ThrEF3vsCsD0.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"31963799215819845041934395777306183587246195740327750578235989254983054030659\",\"outcome\":\"Yes\",\"price\":0.245,\"winner\":false},{\"token_id\":\"4741750186753182970189342469394808014825022