":0.01,\"condition_id\":\"0xd7afa8f3868459d2c64479934411e90a9a3ed1a1961dc577f4d9bd05549bec6e\",\"question_id\":\"0x0030af9b4dc1958d4bbee618fd978732647027e8762fb77df16827dd16ce7c08\",\"question\":\"Will James Parkin advance from the 2026 Alaska Governor primary election?\",\"description\":\"The non-partisan primary election for Governor of Alaska is scheduled to take place on August 18, 2026. The top four candidates in this election by number of votes won will advance to the general election for Governor of Alaska.\\n\\nThis market will resolve to “Yes” If the listed candidate advances from the primary to the general election for Governor of Alaska. Otherwise this market will resolve to “No”.\\n\\nIf no 2026 Alaska gubernatorial primary takes place, this market will resolve to “No.”\\n\\nThis market will resolve based on the results of the primary election for Governor of Alaska as indicated by a consensus of credible reporting. If there is ambiguity, this market will resolve based solely on the official results as reported by the government of Alaska, specifically the State of Alaska Division of Elections.\",\"market_slug\":\"will-james-parkin-advance-from-the-2026-alaska-governor-primary-election\",\"end_date_iso\":\"2026-08-18T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"18790500385588998156571293768149261373854951837528