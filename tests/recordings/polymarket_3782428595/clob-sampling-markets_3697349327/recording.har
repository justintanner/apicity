.\",\"market_slug\":\"no-listed-company-closes-warner-bros-acquisition-by-june-30-2027\",\"end_date_iso\":null,\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0xe8da9a2cb1cca11fe0760d70d59d7a020bb90c9e1ba86141b31144e5f70beb00\",\"neg_risk_request_id\":\"0x2a291671500812ff29b91d5401f7f8478993f77b828442ac2067cb3aa7f3a56d\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-close-warner-bros-acquisition-ZmMrkGXdrnZL.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-close-warner-bros-acquisition-ZmMrkGXdrnZL.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":5}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"49926194611744648925636799110670225431413950541722856824815549402042051978566\",\"outcome\":\"Yes\",\"price\":0.125,\"winner\":false},{\"token_id\":\"92247462418331121567176516538364198127633745062455470091774998340990979894644\",\"outcome\":\"No\",\"price\":0.875,\"winner\":false}],\"tags\":[\"Politics\",\"Tech\",\"Big Tech\",\"Warner Bros\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-06T15:18:45Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xf2982d808c8b0c88ed7d1fd22fb55993b0d1a0f738d202b0a8c2d6805b7125d3\",\"question_id\":\"0x1818633df4657eafadfa53ccfa89ddb34740344609ac2aa3f1164c01d296d6be\",\"question\":\"Insurrection Act invoked by June 30?\",\"description\":\"This market will resolve to \\\"Yes\\\" if Donald Trump officially invokes the Insurrection Act of 1807 by June 30, 2026, 11:59 PM ET. Otherwise, it will resolve to \\\"No\\\".\\n\\nFor the purposes of this market, \\\"invoke\\\" means that the President formally announces the use of the Insurrection Act as legal authority for deploying active-duty U.S. military forces or federalizing the National Guard in response to civil disorder, insurrection, or rebellion.\\n\\nThe resolution source will be a consensus of credible reporting.\",\"market_slug\":\"insurrection-act-invoked-by-june-30-851-924\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/trump-invokes-the-insurrection-act-before-august-jR3s2WWoaIbY.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/trump-invokes-the-insurrection-act-before-august-jR3s2WWoaIbY.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":3}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"79695816237318225067075013824615922295015702104535979808083097817084541762080\",\"outcome\":\"Yes\",\"price\":0.08,\"winner\":false},{\"token_id\":\"82886838000782972044397918838888973114431856431027405244207744342627270948784\",\"outcome\":\"No\",\"price\":0.92,\"winner\":false}],\"tags\":[\"Politics\",\"Trump\",\"Minnesota Unrest\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-26T22:29:57Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x1cf96ff28b0fa76e23f12a0cf299fc3bced8b26e0addfc1ef11fb58347c0216e\",\"question_id\":\"0xda77297a0b9e80b925b132103047e910b399d1bcfb98449408779795d7128000\",\"question\":\"Will Karishma Manzur be the Democratic nominee for Senate in New Hampshire?\",\"description\":\"This market will resolve according to the winner of the Democratic Primary for United States Senator from New Hampshire.\\n\\nIf no 2026 New Hampshire Democratic Senate Primary takes place, this market will resolve to \\\"Other\\\".\\n\\nThe resolution source for this market will be the first announcement of the results from the New Hampshire Democratic party, however an overwhelming consensus of credible reporting may suffice.\",\"market_slug\":\"will-karishma-manzur-be-the-democratic-nominee-for-senate-in-new-hampshire\",\"end_date_iso\":\"2026-09-08T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0xda77297a0b9e80b925b132103047e910b399d1bcfb98449408779795d7128000\",\"neg_risk_request_id\":\"0x42bafcabd1e2b62b070dd99219da043fa6926886d8777efd37aa06008b739ca0\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/new-hampshire-democratic-senate-primary-winner-IVZDasf7HKPj.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/new-hampshire-democratic-senate-primary-winner-IVZDasf7HKPj.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"56624064231610260238088049093024377041287867285559273155770657490459058693715\",\"outcome\":\"Yes\",\"price\":0.039,\"winner\":false},{\"token_id\":\"37806007110699379574196083156782938311392224981899208050840783070359178406119\",\"outcome\":\"No\",\"price\":0.961,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\",\"Democratic Primary\",\"New Hampshire Primary\",\"Senate Primary\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-10-13T23:26:25Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x457e4d4fc56ca3836fccb7a8bf539c787504ac841a933d65f5de0736fcae2567\",\"question_id\":\"0x2aa7cf1991ddab7288bd0590b2e1d2f271900f66f0eabba1b4c9829587e75b00\",\"question\":\"Will the Democrats win the Kansas governor race in 2026?\",\"description\":\"This market will resolve according to the winner of the 2026 Kansas gubernatorial election.\\n\\nA candidate shall be considered to represent a party in the event that he or she is the nominee of the party in question. Candidates other than the Democratic or Republican nominee (e.g., Greens, Libertarian, independent) may be added at a later date.\\n\\nCandidates who run as independents will not be encompassed by the “Democrat” or “Republican” options regardless of any affiliation they may have with the party.\\n\\nThe resolution source for this market is the Associated Press, Fox News, and NBC. This market will resolve once all three sources call the race for the same candidate. If all three sources haven’t called the race in this state for the same candidate, this market will resolve based on the official certification.\",\"market_slug\":\"will-the-democrats-win-the-kansas-governor-race-in-2026\",\"end_date_iso\":null,\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x2aa7cf1991ddab7288bd0590b2e1d2f271900f66f0eabba1b4c9829587e75b00\",\"neg_risk_request_id\":\"0xd6ea31baa02307cd051e5dbe1acaa5a9d07ec2d118af620015b4c074a8772db2\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections-JJ9h02JGR09z.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections-JJ9h02JGR09z.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":100,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"79484096963248498578517243733071571984223432387663163312687533493173144145268\",\"outcome\":\"Yes\",\"price\":0.325,\"winner\":false},{\"token_id\":\"29394102154625046234624466923627257102948178230785334718764086258965622150946\",\"outcome\":\"No\",\"price\":0.675,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"US Election\",\"Midterms\",\"Kansas Midterm\",\"Governor midterms\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-09-23T00:22:36Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0xb77424a53b7480164118374fb5e97b859bd12b696b1aea55d383ce798c060cf4\",\"question_id\":\"0xd2c21cbb9d2cb407ab3dcf619d93f6d65b7967154cd6ee930f7758baa2b4bf02\",\"question\":\"Will OpenAI’s market cap be between $750B and $1T at market close on IPO day?\",\"description\":\"This market will resolve based on OpenAI's market capitalization at the closing price on its first day of trading.\\n\\nIf no IPO occurs by December 31, 2026, 11:59 PM ET, the market will resolve to \\\"No IPO by December 31, 2026\\\".\\n\\nMarket capitalization expresses the monetary value of a company’s outstanding shares, stated in its pricing currency. It is calculated as the number of shares outstanding multiplied by the closing share price on the first trading day.\\n\\nIf the relevant value falls exactly between two brackets, then this market will resolve to the higher range bracket.\\n\\nResolution will be based on the primary exchange’s official listing page. In the event that the relevant figure is not displayed, another reliable source will be used.\\n\\nIn the event of an interruption in the course of the normal trading session on OpenAI’s first day of trading (e.g., a circuit breaker or half-day), the market will resolve according to the official closing price of the abbreviated session. If no such official closing price is published, the market will resolve according to the next trading day on which an official closing price is published, treating that as the first day of trading for purposes of this market.\",\"market_slug\":\"will-openais-market-cap-be-between-750b-and-1t-at-market-close-on-ipo-day\",\"end_date_iso\":\"2026-06-30T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0xd2c21cbb9d2cb407ab3dcf619d93f6d65b7967154cd6ee930f7758baa2b4bf00\",\"neg_risk_request_id\":\"0x02cfa83bf674f5c8de6c027f45d13c44287bb6a17a9b37b6a9d65dd6423ca58f\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/openai-ipo-closing-market-cap-RiLs850YpL5k.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/openai-ipo-closing-market-cap-RiLs850YpL5k.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":5}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"86904220753614324927759730619985568200215013704321476651673438801320577270597\",\"outcome\":\"Yes\",\"price\":0.0245,\"winner\":false},{\"token_id\":\"74987521271361072746264224488245891269775371028979674431826416209897741154003\",\"outcome\":\"No\",\"price\":0.9755,\"winner\":false}],\"tags\":[\"Finance\",\"OpenAI\",\"IPOs\",\"Tech\",\"Big Tech\",\"IPO\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-30T21:32:59Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x5e57757afab43a721c8013dfcd36ec4e89227e9f9e0f4da5a50c23646402aaaa\",\"question_id\":\"0xac59621e92bd5684c67215ec2f2b8aba3e98aaa19a155c1c2279eec9504bcf3d\",\"question\":\"Will Phantom launch a token by June 30, 2026?\",\"description\":\"This market will resolve to “Yes” if Phantom officially launches a governance token by 11:59 PM ET on the date specified in the title. Otherwise, this market will resolve to “No”.\\n\\nThe token must be actively and publicly transferable and tradable. Announcements alone do not qualify.\\n\\nThe primary resolution source for this market will be information from Phantom, however a consensus of credible reporting will also be used.\",\"market_slug\":\"will-phantom-launch-a-token-by-june-30-2026\",\"end_date_iso\":\"2027-01-01T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-phantom-launch-a-token-in-2025-mfGjqFl1jxqW.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-phantom-launch-a-token-in-2025-mfGjqFl1jxqW.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"76189466925627341351692169228426868296055601200116816688000994205306129709524\",\"outcome\":\"Yes\",\"price\":0.0265,\"winner\":false},{\"token_id\":\"75915189707701888373535721978663669687221900757922498040193147317857177456553\",\"outcome\":\"No\",\"price\":0.9735,\"winner\":false}],\"tags\":[\"Crypto\",\"token launch\",\"Pre-Market\",\"phantom\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-18T20:48:33Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xef720745be0a15b63c392854dacae4227a9deafe11fdf6afe79bdf45754dd10a\",\"question_id\":\"0xb55c15acb2eea874fbd324ec0a657e25b782fa28cc4070efa574eb9d34952f61\",\"question\":\"Will Marie Gluesenkamp Perez advance to the general election for WA-03?\",\"description\":\"The non-partisan primary election for the WA-03 congressional district seat in the U.S. House of Representatives is scheduled to take place on August 4, 2026. The two candidates who receive the most votes in this primary election will qualify for the General Election.\\n\\nThis market will resolve to “Yes” If the listed candidate advances from the primary to the general election for the WA-03 congressional district seat in the U.S. House of Representatives. Otherwise this market will resolve to “No”.\\n\\nIf no 2026 WA-03 congressional district primary takes place, this market will resolve to “No.”\\n\\nThis market will resolve based on the results of the primary election for the WA-03 congressional district seat, as indicated by a consensus of credible reporting. If there is ambiguity, this market will resolve based solely on the official results as reported by the government of Washington, specifically the Washington Office of the Secretary of State.\",\"market_slug\":\"will-marie-gluesenkamp-perez-advance-to-the-general-election-for-wa-03\",\"end_date_iso\":\"2026-08-04T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/wa-03-house-election-winner-yhLDeGZqATqe.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/wa-03-house-election-winner-yhLDeGZqATqe.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":3}],\"min_size\":20,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"3289600909948230877821981824702873355442582501668834199910950459441934353064\",\"outcome\":\"Yes\",\"price\":0.93,\"winner\":false},{\"token_id\":\"40722481849389929151523293235390140758174971435264186216685320356921411322177\",\"outcome\":\"No\",\"price\":0.07,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-26T22:15:17Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x23138fc034c49853887431d6009400c26dbfb09525e0edc80878c218d19e28e8\",\"question_id\":\"0xc561662c7f3abc3a9d954656ca7b23f9867d7617733f4f36cac3647734603301\",\"question\":\"Will Christy Davis be the Democratic nominee for Senate in Kansas?\",\"description\":\"This market will resolve according to the winner of the Democratic Primary for United States Senator from Kansas.\\n\\nIf no 2026 Kansas Democratic Senate Primary takes place, this market will resolve to \\\"Other\\\".\\n\\nThe resolution source for this market will be the first announcement of the results from the Kansas Democratic party, however an overwhelming consensus of credible reporting may suffice.\",\"market_slug\":\"will-christy-davis-be-the-democratic-nominee-for-senate-in-kansas\",\"end_date_iso\":\"2026-08-04T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0xc561662c7f3abc3a9d954656ca7b23f9867d7617733f4f36cac3647734603300\",\"neg_risk_request_id\":\"0xcd81da65a6a6ad7cec2c7827f84d85e395251a339fcf4bf38b90614ad18317f8\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/kansas-democratic-senate-primary-winner-AsZ-DS3bB2TU.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/kansas-democratic-senate-primary-winner-AsZ-DS3bB2TU.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":50}],\"min_size\":20,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"68571423472619818785895187841072072034791671005100329725468988805264509815989\",\"outcome\":\"Yes\",\"price\":0.055,\"winner\":false},{\"token_id\":\"10736926434302986558841348050604723050016832369761238191045942284117502122033\",\"outcome\":\"No\",\"price\":0.945,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\",\"Democratic Primary\",\"Senate Primary\",\"Kansas Primary\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-19T23:53:43Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xa27ff8f214d6cfc8c29c8b8f6e2be5fd25243b8e5ca61321df6fa2b387c0d3ad\",\"question_id\":\"0x66e77b37fac30ccea5a3abbf052bcac75829b573de59808e1261f1fac80d7c31\",\"question\":\"Will John Fetterman announce a Presidential run before 2027?\",\"description\":\"This market will resolve to “Yes” if the listed individual officially announces that they are running for U.S. President in the 2028 United States presidential election by December 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to “No”.\\n\\nAn announcement by the listed individual  will be sufficient to trigger a \\\"Yes\\\" resolution, regardless of whether they actually filed a nomination to run, or whether they actually file a nomination to run in the future.\\n\\nThe primary resolution source for this market will be official statements by the listed individual (ex: via speech, social media, etc.), however a consensus of credible reporting may also be used.\",\"market_slug\":\"will-john-fetterman-announce-a-presidential-run-before-2027\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/John_Fetterman.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/John_Fetterman.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"55237126294020307249056722444222886500645044447785757078225410108890086309119\",\"outcome\":\"Yes\",\"price\":0.12,\"winner\":false},{\"token_id\":\"51211799511649199236798994344901598129379192843971998685194139792764927701321\",\"outcome\":\"No\",\"price\":0.88,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Celebrities\",\"President\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-08-22T02:34:05Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x13b62587b14c1c63a6dc344fdd162024a41bafa57c9703a23b5fc8687fd97b1c\",\"question_id\":\"0x6a24e95bf62dac603a1f05ede33b778245a6e90436bb9d1490547fb9ad866000\",\"question\":\"Will Lautaro Martinez be the top goal scorer in the 2025-26 Serie A season?\",\"description\":\"This is a polymarket to predict which player will finish as the top goal scorer in the 2025–26 Serie A season.\\n\\nIf the listed player finishes as the sole top goal scorer in the 2025–26 Serie A season, the market will resolve to \\\"Yes\\\". Otherwise, it will resolve to \\\"No\\\".\\n\\nOnly goals scored in Serie A matches will count. Goals scored in other competitions (e.g., Coppa Italia, Champions League, Europa League, international matches) will not count for this market.\\n\\nIf multiple players tie for the top goal scorer, the market will resolve to the player whose last name comes first alphabetically.\\n\\nIf the 2025–26 Serie A season is canceled or not completed by August 1, 2026, the market will resolve to \\\"Other\\\".\\n\\nThe primary resolution source will be official statistics from Serie A soccer. A consensus of credible reporting may also be used.\",\"market_slug\":\"will-lautaro-martinez-be-the-top-goal-scorer-in-the-2025-26-serie-a-season\",\"end_date_iso\":\"2026-05-28T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x6a24e95bf62dac603a1f05ede33b778245a6e90436bb9d1490547fb9ad866000\",\"neg_risk_request_id\":\"0xa5c6197083d8a2c6a1b0347db2814384ae6bfeeabc97fc904a55adc824634b16\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/serie-a-league-winner--p-sBJv4AsiH.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/serie-a-league-winner--p-sBJv4AsiH.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"70986225091305640716380959980097630324023483012603076578303483234874338420152\",\"outcome\":\"Yes\",\"price\":0.9615,\"winner\":false},{\"token_id\":\"98371578245542994129108533903700071119355453229162840548736057793120737691744\",\"outcome\":\"No\",\"price\":0.0385,\"winner\":false}],\"tags\":[\"Sports\",\"Soccer\",\"Serie A\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-02T18:54:29Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x109e5e08aee879d79a67aa1f22a3bb4684165a64b3fd9c85abecdbb28bf24cf5\",\"question_id\":\"0x6ae3f7452607a987d9188e936a8abeefa63cfc2848940595e29aaeca1bedbede\",\"question\":\"Will US unemployment reach at least 7.0% in 2026?\",\"description\":\"This market will resolve to “Yes” if any seasonally adjusted unemployment rate (total unemployed, as a percent of the civilian labor force, official unemployment rate denoted as U-3) reported by the Bureau of Labor Statistics in an “Employment Situation Report” for a reference month in 2026 is greater than or equal to the listed percentage. Otherwise, this market will resolve to “No”.\\n\\nThe relevant reports for this market are the Employment Situation Reports for January-December, 2026. This market may not resolve to “No” until the Employment Situation report for December 2026 is released. If no Employment Situation Report for December 2026 is released by March 31, 2027, 11:59 PM ET, however, this market will resolve based on all previously published data up to that time. \\n\\nThe resolution source for this market is the Monthly Employment Situation Report, published by the BLS every month at https://www.bls.gov/bls/news-release/empsit.htm, specifically the U-3 measure in Table A-15 for each month.\\n\\nNote: the resolution source for this market reports unemployment to one decimal point. Thus, this is the level of precision that will be used when resolving the market.\",\"market_slug\":\"will-us-unemployment-reach-at-least-7pt0-in-2026\",\"end_date_iso\":\"2026-01-10T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/march-unemployment-rate-wpcB-Q7lTi_r.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/march-unemployment-rate-wpcB-Q7lTi_r.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":3}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"68119694430506374917095643876147104955272369137258737380364271877393537133648\",\"outcome\":\"Yes\",\"price\":0.105,\"winner\":false},{\"token_id\":\"90730065346491050423466890731523173031297529748126652187514109911538674088578\",\"outcome\":\"No\",\"price\":0.895,\"winner\":false}],\"tags\":[\"unemployment\",\"Economy\",\"bls\",\"Macro Indicators\",\"NFP\",\"nonfarm payroll\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-25T23:49:45Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x036154c1906c2abd61a65bc585832e0ef8bdc7795cd05b56a1b5bb96c01e3744\",\"question_id\":\"0x499072ed399ba26ea0003b23544d6c3cd69d7939d51fec45a9903b0aa3964b04\",\"question\":\"Will Jim Oberweis be the Republican nominee for FL-19?\",\"description\":\"This market will resolve according to the candidate who wins the nomination for the Republican Party to contest the FL-19 congressional district seat in the U.S. House of Representatives in the 2026 midterm elections. The Republican primary will take place on August 18, 2026.\\n\\nIf no nominee is announced by November 3, 2026, 11:59PM ET, this market will resolve to \\\"Other\\\".\\n\\nThe resolution source for this market will be a consensus of official Republican sources, including https://www.rnc.org/.\\n\\nAny replacement of the nominee before election day will not change the resolution of the market.\",\"market_slug\":\"will-jim-oberweis-be-the-republican-nominee-for-fl-19\",\"end_date_iso\":\"2026-08-18T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x499072ed399ba26ea0003b23544d6c3cd69d7939d51fec45a9903b0aa3964b00\",\"neg_risk_request_id\":\"0x490b5a79d782896639341a5ba4f5c8f7ed1332f5a9a4139e3279923d37c5e681\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/fl-19-republican-primary-winner-2ToufkrIf6vW.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/fl-19-republican-primary-winner-2ToufkrIf6vW.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"10271357710396906917757505521483380079917105504278244752478183623720497