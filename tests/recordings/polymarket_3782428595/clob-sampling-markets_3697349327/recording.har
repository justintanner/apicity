mm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x3a75c58b84fe6de5b39d907d4c45ac4ed490afb86110a20fc43cfe835e36fa00\",\"neg_risk_request_id\":\"0xb3da7d23bc975776ec163b6f04107d8cd002c9e857c4a4060e021b0a470f74df\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/iowa-governor-republican-primary-winner-v2jo0O-KShxg.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/iowa-governor-republican-primary-winner-v2jo0O-KShxg.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"112422238158894931117138324232508753203082699318825750426315053102734155432020\",\"outcome\":\"Yes\",\"price\":0.065,\"winner\":false},{\"token_id\":\"58165266849644979606503842903144221039294652920528893223251001640270163821395\",\"outcome\":\"No\",\"price\":0.935,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\",\"Republican Primary\",\"Governor Primary\",\"Iowa Primary\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-02T22:58:31Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xe243748396163f096042bb0c7ea137a864f5259b9b906ce1656ec8d4bd3c64d0\",\"question_id\":\"0x6606eb60c0ec75e4ec9b2d25cc743e0249d07aba45f3adf5cedc4724d08ab3ff\",\"question\":\"Will Trump pardon Martin Shkreli before 2027?\",\"description\":\"This market will resolve to \\\"Yes\\\" if the listed individual receives a presidential pardon, commutation, or reprieve from Donald Trump between January 2, 2026 and December 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to \\\"No\\\".\\n\\nThe primary resolution source for whether the individual is pardoned or not will be official information from the US government, however a consensus of credible reporting will also be used.\",\"market_slug\":\"will-trump-pardon-martin-shkreli-before-2027\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-trump-pardon-keonne-rodriguez-before-2027-927PlR9VAWMu.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-trump-pardon-keonne-rodriguez-before-2027-927PlR9VAWMu.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"104164365396079964916732796976774053098405712440431403709738662609283039419996\",\"outcome\":\"Yes\",\"price\":0.065,\"winner\":false},{\"token_id\":\"73359787854575209526069892726328653913614850338242402377058753281542171114593\",\"outcome\":\"No\",\"price\":0.935,\"winner\":false}],\"tags\":[\"Politics\",\"Trump\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-04T23:19:41Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x1a4ab89a78e5d71ec75589b868b3222bdbed30260a5c431ccb11a21b152eabf4\",\"question_id\":\"0x8406262461850e243b75a79f23edbecce0640c37491779cdb7adf865aa985680\",\"question\":\"Will Zoltan Istvan advance from the 2026 California Governor primary election?\",\"description\":\"The non-partisan primary election for Governor of California is scheduled to take place on June 2, 2026. The top two candidates in this election by number of votes won will advance to the general election for Governor of California.\\n\\nThis market will resolve to “Yes” If the listed candidate advances from the primary to the general election for Governor of California. Otherwise this market will resolve to “No”.\\n\\nIf no 2026 California gubernatorial primary takes place by December 31, 2026, this market will resolve to “No.”\\n\\nThis market will resolve based on the results of the primary election for Governor of California as indicated by a consensus of credible reporting. If there is ambiguity, this market will resolve based solely on the official results as reported by the government of California, specifically the Office of the Secretary of State.\",\"market_slug\":\"will-zoltan-istvan-get-the-first-or-second-most-votes-in-the-2026-california-governor-primary-election\",\"end_date_iso\":\"2026-06-02T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/california-governor-election-2026-4b5HcLPNupez.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/california-governor-election-2026-4b5HcLPNupez.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"95334434781976495002736457147425197290918934785230826193632059656662864523993\",\"outcome\":\"Yes\",\"price\":0.0205,\"winner\":false},{\"token_id\":\"23685022642556613588340027678314664242937035872902260236106614258421482481837\",\"outcome\":\"No\",\"price\":0.9795,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-05T13:51:45Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xd09e776661872b9af66a8cb34d38211196d03710bcd9eb376ee5ff02bfe0e43e\",\"question_id\":\"0xb1d52cd5831dea01d1699e9d220d9f3d97fb21e76937182b7118d8f90c53ee12\",\"question\":\"Ostium FDV above $500M one day after launch?\",\"description\":\"This market will resolve to \\\"Yes\\\" if the Fully Diluted Valuation of Ostium's token is greater than the value specified in the title 1 day after launch. Otherwise, the market will resolve to \\\"No.\\\"\\n\\nThe token must be actively, publicly transferable and tradable to be considered a launch.\\n\\nThe FDV will be determined using the total token supply multiplied by the token price.\\n\\n\\\"1 day after launch\\\" is defined as 4:00 PM ET on the calendar day following launch. The resolution source for this market is the most liquid price source available. If Ostium doesn't launch a token by December 31, 2026, 11:59 PM ET, this market will resolve to \\\"No\\\".\",\"market_slug\":\"ostium-fdv-above-500m-one-day-after-launch-834\",\"end_date_iso\":\"2027-01-01T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-ostium-launch-a-token-in-2025-2WMInwUi6onf.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-ostium-launch-a-token-in-2025-2WMInwUi6onf.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"110899108313812961415681560453228181567230636983049923691596868612912451610122\",\"outcome\":\"Yes\",\"price\":0.28,\"winner\":false},{\"token_id\":\"111779172182387333694290156010331334755635854754465403726376754129265317458659\",\"outcome\":\"No\",\"price\":0.72,\"winner\":false}],\"tags\":[\"Crypto\",\"FDV\",\"Pre-Market\",\"Ostium\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-14T19:52:46Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x422053c43f7852ca503b597939c0d5ba7a8a4c00427ede607a4bcc27d4e314aa\",\"question_id\":\"0x8fa76ea3b22e1f763275bc7c7b3963e10b5615303521038b970de9947de18c05\",\"question\":\"Will Republican Senate incumbents not win in more than four nominating elections in the 2026 cycle?\",\"description\":\"The 2026 midterm elections are scheduled to be held on November 3, 2026, with congressional primaries running from March through September.\\n\\nThis market will resolve according to the number of Republican Senate incumbents who do not win their nominating election to move on to the general election as a result of the 2026 midterm primary elections.\\n\\nAn incumbent will be considered not to have won their election if they are not declared the winner of the election they sought, including if they withdraw, suspend, or otherwise leave the race at any point after officially registering as a candidate, regardless of the reason. Incumbents who do not officially register as candidates for reelection will not be considered.\\n\\nThis market will resolve based on the results of all Senate nominating elections, including party primaries, top-two or jungle primaries, and primaries for special elections, that are scheduled to occur between March 1 and September 30, 2026. If a required runoff for any such election or a subsequent qualifying round in a non-partisan primary system could change the market’s outcome, the market will remain open until that contest is conclusively called by this market’s resolution sources.\\n\\nA candidate's party will be determined by their ballot-listed or otherwise identifiable affiliation with that party at the time of their nominating election. A candidate without a ballot-listed affiliation to either the Democratic or Republican parties will be considered a member of one of these parties based on the party with which they most recently expressed their intent to caucus prior to the conclusion of the relevant nominating election.\\n\\nThe resolution source for this market will be the Associated Press, Fox News, and NBC. This market will resolve once all three sources have conclusively called all relevant nominating elections. If all three sources do not achieve consensus in calling the relevant races for this market, it will resolve based on official state certification of the nominating election results.\",\"market_slug\":\"will-republican-senate-incumbents-not-win-in-more-than-four-nominating-elections-in-the-2026-cycle\",\"end_date_iso\":null,\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x8fa76ea3b22e1f763275bc7c7b3963e10b5615303521038b970de9947de18c00\",\"neg_risk_request_id\":\"0xc7cbf2cae98fe21299f6cb8ef15387fab783e3a6ff49cf9f09f6b9d82c1fca2f\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-republicans-lose-a-seat-in-the-us-senate-for-any-state-trump-won-in-2024-36T8qr8R2Va9.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-republicans-lose-a-seat-in-the-us-senate-for-any-state-trump-won-in-2024-36T8qr8R2Va9.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"99949820195875612992810448039847840508153725698657233135087297464049362042096\",\"outcome\":\"Yes\",\"price\":0.037,\"winner\":false},{\"token_id\":\"59121221960767940820018969033479379752445235818757826836474296216659648279628\",\"outcome\":\"No\",\"price\":0.963,\"winner\":false}],\"tags\":[\"Politics\",\"Trump\",\"Elections\",\"Primaries\",\"Congress\",\"US Election\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-10T21:12:22Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xd4e5831d2c951273ae9944cc3972eb09dc257a57d97ff5954ff2a443a194f318\",\"question_id\":\"0x26a33decea6f8b915cae8636c93dd731df3f73cfca583dea9feb15c7b6127112\",\"question\":\"Will Hank Kroll advance from the 2026 Alaska Governor primary election?\",\"description\":\"The non-partisan primary election for Governor of Alaska is scheduled to take place on August 18, 2026. The top four candidates in this election by number of votes won will advance to the general election for Governor of Alaska.\\n\\nThis market will resolve to “Yes” If the listed candidate advances from the primary to the general election for Governor of Alaska. Otherwise this market will resolve to “No”.\\n\\nIf no 2026 Alaska gubernatorial primary takes place, this market will resolve to “No.”\\n\\nThis market will resolve based on the results of the primary election for Governor of Alaska as indicated by a consensus of credible reporting. If there is ambiguity, this market will resolve based solely on the official results as reported by the government of Alaska, specifically the State of Alaska Division of Elections.\",\"market_slug\":\"will-hank-kroll-advance-from-the-2026-alaska-governor-primary-election\",\"end_date_iso\":\"2026-08-18T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-advance-from-the-alaska-governor-primary-7EPybqNOA6-J.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"10210050108466718077304773456814842377493587258420052316361453244816894172598\",\"outcome\":\"Yes\",\"price\":0.115,\"winner\":false},{\"token_id\":\"102763251617305570128262108272844255249699700027337279998264726491688703455184\",\"outcome\":\"No\",\"price\":0.885,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2026-01-05T23:08:41Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0x14933f8d6071a74b7f0547bdb3bc19eb7080b1064c39bd60f6202be03669c8e0\",\"question_id\":\"0x1b4edde329c109111397d0b23288911f372f36634ba2d9256ca607b9d3fb8301\",\"question\":\"Will Perplexity’s market cap be between $20B and $30B at market close on IPO day?\",\"description\":\"This market will resolve based on Perplexity's market capitalization at the closing price on its first day of trading.\\n\\nIf no Perplexity IPO occurs by December 31, 2027, 11:59 PM ET, the market will resolve to \\\"No IPO before 2028\\\".\\n\\nMarket capitalization expresses the monetary value of a company’s outstanding shares, stated in its pricing currency. It is calculated as the number of shares outstanding multiplied by the closing share price on the first trading day.\\n\\nIf the relevant value falls exactly between two brackets, then this market will resolve to the higher range bracket.\\n\\nResolution will be based on the primary exchange’s official listing page. In the event that the relevant figure is not displayed, another reliable source will be used.\\n\\nIn the event of an interruption in the course of the normal trading session on Perplexity’s first day of trading (e.g., a circuit breaker or half-day), the market will resolve according to the official closing price of the abbreviated session. If no such official closing price is published, the market will resolve according to the next trading day on which an official closing price is published, treating that as the first day of trading for purposes of this market.\",\"market_slug\":\"will-perplexitys-market-cap-be-between-20b-and-40b-at-market-close-on-ipo-day\",\"end_date_iso\":\"2027-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x1b4edde329c109111397d0b23288911f372f36634ba2d9256ca607b9d3fb8300\",\"neg_risk_request_id\":\"0x005d87ded45ccd7edd8a0900e6ef2c068ba0adf8c68bcf384f4b07e45bc92e51\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/perplexity-ipo-closing-market-cap-anTspp_8FLb0.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/perplexity-ipo-closing-market-cap-anTspp_8FLb0.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"107402821793305151529529667256418244316668317163364567659023123151649566158782\",\"outcome\":\"Yes\",\"price\":0.036,\"winner\":false},{\"token_id\":\"2516401460542825227911990110308102196879753247765127593809220462963454126993\",\"outcome\":\"No\",\"price\":0.964,\"winner\":false}],\"tags\":[\"Business\",\"AI\",\"IPOs\",\"Tech\",\"Big Tech\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-26T21:44:51Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0xcbd66faaf74bf50d61ab2f63f9351f8086305dcbf16c1e3eab0ebfe576fce1c6\",\"question_id\":\"0xf8799965e21bb107c7f61c0a8062dd8c7bc9fa87e2fc6d9d3d20a15730fe2717\",\"question\":\"Will Russia enter Druzkhivka by June 30?\",\"description\":\"This market will resolve to “Yes” if, according to the ISW map, Russia captures any territory of Druzkhivka (https://maps.app.goo.gl/cH9ekgbf9qbxGPUk6) by June 30, 2026, at 11:59 PM ET.\\n\\nTerritory will be considered captured if any part of the city or settlement is shaded under a below specified layer on the ISW map (https://storymaps.arcgis.com/stories/36a7f6a6f5a9448496de641cf64bd375) by the resolution date. Otherwise, the market will resolve to “No”.\\n\\nFor any change on the ISW map to qualify for this market’s resolution, the relevant shading indicating Russian control must persist through the next full ISW daily update cycle. If ISW skips a day, shading must persist until the next finalized ISW update is published, regardless of the date. Any continuous shading which reflects either \\\"Assessed Russian Infiltration Areas in Ukraine\\\", “Assessed Russian Control”, “Assessed Russian Advance In Ukraine”, or “Assessed Russian Gains in the Past 24 Hours” will qualify. \\n\\nOnce a qualifying condition is met, any subsequent loss of control will not be considered towards the resolution of this market.\\n\\nIf Russia comes into control of the specified territory as a result of a negotiated settlement, this will qualify for a 'Yes' resolution, regardless of whether it is shaded red in the ISW map. However, an announcement of a negotiated settlement that gives Russia de jure control will not qualify. Actual control must be established.\\n\\nThe primary resolution source for this market will be the ISW Ukraine map. If the ISW map is rendered unavailable, information from DeepStateMap (https://deepstatemap.live/) may be used. If information from both the ISW and DeepStateMap are rendered permanently unavailable, a consensus of credible reporting may be used.\\n\\nNote: Any temporary glitches or errors in the map will not be considered.\",\"market_slug\":\"will-russia-enter-druzkhivka-by-june-30-933-897\",\"end_date_iso\":\"2026-06-30T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":0,\"taker_base_fee\":0,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-russia-enter-druzkhivka-by-june-30-933-897-xEmtV7yneFsP.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-russia-enter-druzkhivka-by-june-30-933-897-xEmtV7yneFsP.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":5}],\"min_size\":40,\"max_spread\":5.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"64873759235836285759433963153564476696368251894659048693711318733282140962729\",\"outcome\":\"Yes\",\"price\":0.08,\"winner\":false},{\"token_id\":\"12189953254757703901325817136807905828235414540096236570030539521489183912836\",\"outcome\":\"No\",\"price\":0.92,\"winner\":false}],\"tags\":[\"Ukraine\",\"Geopolitics\",\"Ukraine Map\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-11-12T22:49:00Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x0e159c0d672526d1d65f524b1c512185924aac8f781b6c68549c2a17dec953e0\",\"question_id\":\"0x120b4e300e2385e7a71fa1e7137e97eaa03f4e4c3b3695bb57d0acd433aed28b\",\"question\":\"Will the 10-year Treasury yield hit 5.0% before 2027?\",\"description\":\"This market will resolve to \\\"Yes\\\" if the Treasury 10-year yield reaches or is higher than the listed value for any date between November 11, 2025 and December 31, 2026. Otherwise this market will resolve to \\\"No\\\".\\n\\nThe resolution source for this market is the Department of the treasury, specially the data listed under \\\"Daily Treasury Par Yield Curve Rates\\\" for the column \\\"10 Yr\\\" (see: https://home.treasury.gov/resource-center/data-chart-center/interest-rates/TextView?type=daily_treasury_yield_curve\\u0026field_tdr_date_value=2025).\",\"market_slug\":\"will-the-10-year-treasury-yield-hit-5pt0-before-2027-735-167\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-10-year-treasury-yield-hit-5pt0-in-2025-JnUaHlvmppnU.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-10-year-treasury-yield-hit-5pt0-in-2025-JnUaHlvmppnU.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"22397766228589110871783272985290872433765236471932774952155419500943165057456\",\"outcome\":\"Yes\",\"price\":0.135,\"winner\":false},{\"token_id\":\"64711786665968428193644926367505584839826326600641979004261957536577681115496\",\"outcome\":\"No\",\"price\":0.865,\"winner\":false}],\"tags\":[\"Finance\",\"Fed Rates\",\"Economy\",\"Jerome Powell\",\"Treasuries\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-29T21:46:25Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0xa034dea15732928b29345412b50134cb6f54b4fc5aa2732b7ee32eb723113d2a\",\"question_id\":\"0xa337ca15e731df93bfaa84a15c8bae1ad87e80a3a7cfe7569230ba20d4942a7c\",\"question\":\"Thailand strikes Cambodia by June 30, 2026?\",\"description\":\"This market will resolve to \\\"Yes\\\" if Thailand initiates a drone, missile, or air strike on Cambodian soil or any Cambodian embassy or consulate by the specified date, 11:59 PM ET. Otherwise, this market will resolve to \\\"No\\\".\\n\\nFor the purposes of this market, a qualifying \\\"strike\\\" is defined as the use of aerial bombs, drones or missiles (including cruise or ballistic missiles) launched by Thai military forces that impact Cambodian ground territory or any official Cambodian embassy or consulate (e.g., if a weapons depot on Cambodian soil is hit by an Thailand missile, this market will resolve to \\\"Yes\\\") that is officially acknowledged by the Thailand government or a consensus of credible reporting.\\n\\nMissiles or drones which are intercepted and surface-to-air missile strikes will not be sufficient for a \\\"Yes\\\" resolution regardless of whether they land on Cambodian territory or cause damage.\\n\\nActions such as artillery fire, small arms fire, FPV or ATGM strikes directly, ground incursions, naval shelling, cyberattacks, or other operations conducted by Thai ground operatives will not qualify.\\n\\nThe resolution source will be a consensus of credible reporting.\\n\\nIf there is ambiguity as to whether a qualifying strike occurred, this market may remain open after resolution time for confirming evidence.\",\"market_slug\":\"thailand-strikes-cambodia-by-june-30-2026\",\"end_date_iso\":\"2026-06-30T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":0,\"taker_base_fee\":0,\"notifications_enabled\":true,\"neg_risk\":false,\"neg_risk_market_id\":\"\",\"neg_risk_request_id\":\"\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/thailand-strikes-cambodia-by-friday-s2_f6oWpx1-Q.jpg\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/thailand-strikes-cambodia-by-friday-s2_f6oWpx1-Q.jpg\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":0.001}],\"min_size\":20,\"max_spread\":3.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"54530159912935281128189289011057041431260583876742614839278125319915139538808\",\"outcome\":\"Yes\",\"price\":0.051,\"winner\":false},{\"token_id\":\"58979931984028649027469831662313040356648174726349621873659123229327887272691\",\"outcome\":\"No\",\"price\":0.949,\"winner\":false}],\"tags\":[\"Politics\",\"Military Actions\",\"Geopolitics\",\"World\",\"Asia\",\"Thailand-Cambodia\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-11T17:50:45Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.01,\"condition_id\":\"0x8d240de0d0ab5a55bc688eb09ca7066a023fc0942a08d6cb2607971eb87d936f\",\"question_id\":\"0x13b0072054c0e27a751fd2162c67c41e19ae6159ce646151d820e52961ae9801\",\"question\":\"Will Josh Tenorio win the 2026 Guam Governor Democratic primary election?\",\"description\":\"This market will resolve according to the winner of the Democratic Primary for Governor of Guam, scheduled to take place on August 1, 2026. Resolution will be based on the overall winner of the primary, including any potential second round or run-off.\\n\\nIf no 2026 Guam Gubernatorial Democratic Primary takes place, this market will resolve to “Other.”\\n\\nThe resolution source for this market will be the first official announcement of the results from the Guam Democratic Party; however, an overwhelming consensus of credible reporting may suffice.\",\"market_slug\":\"will-josh-tenorio-win-the-2026-guam-governor-democratic-primary-election\",\"end_date_iso\":\"2026-08-01T00:00:00Z\",\"game_start_time\":null,\"seconds_delay\":0,\"fpmm\":\"\",\"maker_base_fee\":1000,\"taker_base_fee\":1000,\"notifications_enabled\":true,\"neg_risk\":true,\"neg_risk_market_id\":\"0x13b0072054c0e27a751fd2162c67c41e19ae6159ce646151d820e52961ae9800\",\"neg_risk_request_id\":\"0xb631ba832de35116b905253f514154c27f0d96a5ef979085597b5cb4f0ff6643\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/guam-governor-democratic-primary-winner-a7Bg063rfnia.png\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/guam-governor-democratic-primary-winner-a7Bg063rfnia.png\",\"rewards\":{\"rates\":[{\"asset_address\":\"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174\",\"rewards_daily_rate\":1}],\"min_size\":50,\"max_spread\":4.5},\"is_50_50_outcome\":false,\"tokens\":[{\"token_id\":\"23275115450204422360076864175496040998891442763150170041414999482132211601741\",\"outcome\":\"Yes\",\"price\":0.29,\"winner\":false},{\"token_id\":\"83904304744146114377348747402863864146441489740476307270730888074551209899324\",\"outcome\":\"No\",\"price\":0.71,\"winner\":false}],\"tags\":[\"Politics\",\"Elections\",\"Primaries\",\"primary elections\",\"Democratic Primary\",\"Governor Primary\"]},{\"enable_order_book\":true,\"active\":true,\"closed\":false,\"archived\":false,\"accepting_orders\":true,\"accepting_order_timestamp\":\"2025-12-12T00:45:06Z\",\"minimum_order_size\":5,\"minimum_tick_size\":0.001,\"condition_id\":\"0xbab5a91f04f1ebe8fb3842b90e0b59c04b59a17f4b7ee67aeb6ad30cdba3fdae\",\"question_id\":\"0xa92a811c7c6c16f777a36a01ec7cc90d11c2fce29b5f3a046fe04052d0722a02\",\"question\":\"Will 7-8 SpaceX Starship launches successfully reach Space in 2026?\",\"description\":\"This market will resolve according to the number of SpaceX Starship launches successfully reaching an altitude of 62 miles above sea level between January 1, 2026, and December 31, 2026, 11:59 PM ET. Otherwise, this market will resolve to \\\"No\\\".\\n\\nA successful launch is defined as the Starship taking off from its launchpad and reaching a minimum altitude of 62 miles above sea level. Any subsequent anomaly (e.g., an explosion) after the vehicle reaches 62 miles will have no bearing on the outcome.\\n\\nThe primary resolution source for this market will be SpaceX’s official video feed of the launches (e.g., via SpaceX YouTube Channel), as well as secondary video feeds or written reports if necessary. However, a consensus of credible reporting may also be used.\",\"market_slug\":\"will-7-8-spacex-starship-launches-successfully-reach-space-in-2026\",\"end_date_iso\":\"2026-12-31T00:00:00Z\",\"game_start_time\":null,\"sec