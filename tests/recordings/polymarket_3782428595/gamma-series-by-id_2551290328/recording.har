\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"4640\",\"ticker\":\"who-will-win-the-2022-nfl-pro-bowl\",\"slug\":\"who-will-win-the-2022-nfl-pro-bowl\",\"title\":\"Who will win the 2022 NFL Pro Bowl?\",\"description\":\"The AFC-NFC Pro Bowl is the all-star game of the National Football League (NFL), matching the top players in the American Football Conference (AFC) against those in the National Football Conference (NFC).  2022 Pro Bowl is scheduled to be played at Allegiant Stadium in Las Vegas, Nevada, on February 6, 2022.\\n\\nThis market will resolve to \\\"AFC\\\" if the winning team is affiliated with The American Football Conference (AFC), and to \\\"NFC\\\" if the winning team is affiliated with The National Football Conference (NFC).\\n\\nIf for any reason the winner is not decided by February 20 2022 (11:59:59 PM ET), this market will resolve 50-50.\",\"resolutionSource\":\"https://www.nfl.com/\",\"startDate\":\"2022-01-26T00:00:00Z\",\"creationDate\":\"2022-01-26T00:00:00Z\",\"endDate\":\"2022-02-06T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-win-the-2022-nfl-pro-bowl-3c0d6d47-ae58-4fa4-8131-e1af44e4c735.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/who-will-win-the-2022-nfl-pro-bowl-3c0d6d47-ae58-4fa4-8131-e1af44e4c735.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":true,\"liquidity\":0,\"volume\":4431.38,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:41:10.198+00\",\"createdAt\":\"2022-07-27T14:41:10.201Z\",\"updatedAt\":\"2024-04-25T19:32:41.194119Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"upd