\":false,\"requiresTranslation\":false},{\"id\":\"5368\",\"ticker\":\"will-the-browns-beat-the-falcons-by-more-than-6-points-in-their-nfl-preseason-matchup\",\"slug\":\"will-the-browns-beat-the-falcons-by-more-than-6-points-in-their-nfl-preseason-matchup\",\"title\":\"Will the Browns beat the Falcons by more than 6 points in their NFL preseason matchup?\",\"description\":\"This is a market on whether the Cleveland Browns will beat the Atlanta Falcons by over 6 points in their NFL preseason matchup scheduled to take place on August 29, 2021. This market will resolve to “Yes” if the Cleveland Browns win by over 6 points, and “No” otherwise. If the match is postponed to a date on or before September 29, 2021, the same market conditions will apply. If the match is postponed to a date after September 29, 2021, or canceled altogether, the market will resolve 50-50. In the event of ambiguity in terms of the market outcome, the market will be resolved in good faith at the sole discretion of the Markets Integrity Committee (MIC).\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-08-29T00:00:00Z\",\"creationDate\":\"2021-08-29T00:00:00Z\",\"endDate\":\"2021-08-29T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-browns-beat-the-falcons-by-more-than-6-points-in-their-nfl-preseason-matchup-fe476729-ac99-46ec-b111-d4aebdf5478c.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-browns-beat-the-falcons-by-more-than-6-points-in-their-nfl-preseason-matchup-fe476729-ac99-46ec-b111-d4aebdf5478c.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":3491.78,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:41:37.867+00\",\"createdAt\":\"2022-07-27T14:41:37.871Z\",\"updatedAt\":\"2024-04-23T22:53:53.104644Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volum