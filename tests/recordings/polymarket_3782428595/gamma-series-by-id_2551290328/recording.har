.amazonaws.com/super+bowl+lvii.png\",\"disqusThread\":\"superbowl-lvii\",\"enableOrderBook\":true,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2023-02-13T05:32:34Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"901278\",\"ticker\":\"rihanna-nip-slip\",\"slug\":\"rihanna-nip-slip\",\"title\":\"Rihanna nip slip?\",\"description\":\"This market will resolve to \\\"Yes\\\" if one or both of Rihanna's nipples becomes visible during the live broadcast of the Super Bowl LVII Halftime Show. Otherwise, this market will resolve to \\\"No\\\".\\n\\nThis market will resolve to \\\"Yes\\\" if one or both of Rihanna's nipples becomes visible regardless of whether it is through clothing, or as bare skin.\\n\\nIf this game's halftime show is not completed by March 12, 2023, 11:59:59 PM ET, this market will resolve 50-50.\\n\\nThe primary resolution source for this market will be official information from the NFL and live footage from Super Bowl LVII, however a consensus of credible reporting may also be used.\",\"resolutionSource\":\"\",\"startDate\":\"2023-02-12T00:00:00Z\",\"creationDate\":\"2023-02-12T00:00:00Z\",\"endDate\":\"2023-02-12T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/rihanna+bust.jpeg\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/rihanna+bust.jpeg\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":true,\"liquidity\":0,\"volume\":1077.38,\"openInterest\":0,\"sortBy\":\"ascending\",\"published_at\":\"2023-02-12 19:37:05.883+00\",\"createdAt\":\"2023-02-12T19:37:05.902Z\",\"updatedAt\":\"2024-0