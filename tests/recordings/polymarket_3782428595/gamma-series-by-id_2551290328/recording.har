volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:02.53Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"2929\",\"ticker\":\"in-game-trading-will-the-raiders-or-the-steelers-win-their-nfl-week-2-matchup-1\",\"slug\":\"in-game-trading-will-the-raiders-or-the-steelers-win-their-nfl-week-2-matchup-1\",\"title\":\"(In-Game Trading) Will the Raiders or the Steelers win their NFL week 2 matchup?\",\"description\":\"This is a market on whether the Las Vegas Raiders or the Pittsburgh Steelers will win their NFL week two game on September 19, 2021, at 1:00 PM ET. This market will resolve to “Raiders” if the Raiders win, and “Steelers” if the Steelers win. If the match is postponed to a date on or before October 19, 2021, the same market conditions will apply. If the match is postponed to a date after October 19, 2021, or canceled altogether, the market will resolve 70-30 in favor of the Steelers. \",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-09-19T00:00:00Z\",\"creationDate\":\"2021-09-19T00:00:00Z\",\"endDate\":\"2021-09-19T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/in-game-trading-will-the-raiders-or-the-steelers-win-their-nfl-week-2-matchup-a33830ad-9a49-4dc7-812e-3ba69868155f.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/in-game-trading-will-the-raiders-or-the-steelers-win-their-nfl-week-2-matchup-a33830ad-9a49-4dc7-812e-3ba69868155f.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":10895.18,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:03.876+00\",\"createdAt\":\"2022-07-27T14:40:03.879Z\",\"updatedAt\":\"2024-04-22T20:51:13.362279Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:03.879Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"2930\",\"ticker\":\"will-the-raiders-beat-the-dolphins-by-more-than-3pt5-points-in-their-week-three-matchup\",\"slug\":\"will-the-raiders-beat-the-dolphins-by-more-than-3pt5-points-in-their-week-three-matchup\",\"title\":\"Will the Raiders beat the Dolphins by more than 3.5 points in their week three matchup?\",\"description\":\"This is a market on whether the Las Vegas Raiders will beat the Miami Dolphins by over 3.5 points in their NFL week three matchup scheduled to take place on September 26, 2021, at 4:05 PM ET. This market will resolve to “Yes” if the Raiders win by over 3.5 points, and “No” if the Dolphins lose by less than 3.5 points or win. If the match is postponed to a date on or before October 26, 2021, the same market conditions will apply. If the match is postponed to a date after October 26, 2021, or canceled altogether, the market will resolve 55-45 in favor of “No”.\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-09-26T00:00:00Z\",\"creationDate\":\"2021-09-26T00:00:00Z\",\"endDate\":\"2021-09-26T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-raiders-beat-the-dolphins-by-more-than-35-points-in-their-week-three-matchup-af0443d4-8d4e-4671-b6ff-4067ef0da900.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-raiders-beat-the-dolphins-by-more-than-35-points-in-their-week-three-matchup-af0443d4-8d4e-4671-b6ff-4067ef0da900.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":7922.34,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:03.918+00\",\"createdAt\":\"2022-07-27T14:40:03.922Z\",\"updatedAt\":\"2024-04-22T21:24:27.685218Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:03.922Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"2960\",\"ticker\":\"will-any-of-the-first-10-picks-in-the-nfl-draft-be-traded-during-the-draft\",\"slug\":\"will-any-of-the-first-10-picks-in-the-nfl-draft-be-traded-during-the-draft\",\"title\":\"Will any of the first 10 picks in the NFL draft be traded during the draft?\",\"description\":\"This is a market on whether any of the first 10 picks in the first round of the 2021 NFL draft will be traded during the NFL draft, currently scheduled for April 29, 2021. This market will resolve to “Yes” if an official trade of one of the first 10 picks in the 2021 NFL draft from one team to another is announced, at any time after the team with the 1st overall pick goes on the clock to any time before the team with the 11th overall pick goes on the clock. This market will resolve “No” otherwise. The resolution source for this market will be the live broadcast of the NFL draft, as well as credible news reports of a trade taking place or press releases or any official announcement from the NFL or an NFL team’s official representatives. This market will resolve after the team with the 11th pick in the NFL draft goes on the clock. If the NFL draft is delayed, this market will be delayed until the NFL Draft takes place. If the NFL draft still has not taken place by June 1, 12:00 PM ET, this market will resolve 50-50.\",\"startDate\":\"2021-04-27T00:00:00Z\",\"creationDate\":\"2021-04-27T00:00:00Z\",\"endDate\":\"2021-04-29T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-any-of-the-first-10-picks-in-the-nfl-draft-be-traded-during-the-draft-eafddff4-5834-4d7c-b9ae-2463ab57d1e5.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-any-of-the-first-10-picks-in-the-nfl-draft-be-traded-during-the-draft-eafddff4-5834-4d7c-b9ae-2463ab57d1e5.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":5442.84,\"openInterest\":0,\"sortBy\":\"ascending\",\"published_at\":\"2022-07-27 14:40:05.241+00\",\"createdAt\":\"2022-07-27T14:40:05.244Z\",\"updatedAt\":\"2024-04-23T22:44:45.607237Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:05.244Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"2966\",\"ticker\":\"nfl-will-the-cowboys-beat-the-washington-by-more-than-10pt5-points-in-their-decem