ate\":\"2021-10-07T00:00:00Z\",\"endDate\":\"2021-10-10T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/in-game-trading-will-the-jets-or-falcons-win-their-week-five-matchup-400a5400-add0-43c1-93d0-d5c3d6ae44ba.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/in-game-trading-will-the-jets-or-falcons-win-their-week-five-matchup-400a5400-add0-43c1-93d0-d5c3d6ae44ba.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":40533.79,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:07.759+00\",\"createdAt\":\"2022-07-27T14:40:07.765Z\",\"updatedAt\":\"2024-04-25T19:21:47.215384Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:07.765Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"3046\",\"ticker\":\"will-there-be-another-1071st-nfl-scorigami-in-november-2021\",\"slug\":\"will-there-be-another-1071st-nfl-scorigami-in-november-2021\",\"title\":\"Will there be another (1071st) NFL Scorigami in November 2021?\",\"description\":\"In sports, a Scorigami is a scoring combination that has never happened before in a sport or league's history. \\n\\nIn NFL's history, there have been 1070 unique scores. \\nThe most recent Scorigami for an NFL game occurred on November 21, 2021, when the Indianapolis Colts defeated the Buffalo Bills by a score of 41–15.\\n\\nThis market will resolve to \\\"Yes\\\" if at least one more NFL Scorigami will occur after the market inception date, November 22, 8 AM ET, and before the market resolution time, November 30, 11:00 PM ET.\\nOtherwise, this market will resolve to \\\"No\\\".\\n\\nThe resolution source for this market is an official NFL website (https://www.nfl.com/scores/), however other sites tracking Scorigamis will be helpful (https://nflscorigami.com/, https://twitter.com/NFL_Scorigami)\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-11-22T00:00:00Z\",\"creationDate\":\"2021-11-22T00:00:00Z\",\"endDate\":\"2021-11-30T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-there-be-another-1071st-nfl-scorigami-in-november-2021-8ed381f6-ce2d-44b5-a810-d9c97290c405.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-there-be-another-1071st-nfl-scorigami-in-november-2021-8ed381f6-ce2d-44b5-a810-d9c97290c405.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":7312.2,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:09.027+00\",\"createdAt\":\"2022-07-27T14:40:09.03Z\",\"updatedAt\":\"2024-04-25T19:33:43.004482Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:09.03Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"3054\",\"ticker\":\"nfl-will-the-cardinals-beat-the-lions-by-more-than-13pt5-points-in-their-december-19-matchup\",\"slug\":\"nfl-will-the-cardinals-beat-the-lions-by-more-than-13pt5-points-in-their-december-19-matchup\",\"title\":\"NFL: Will the Cardinals beat the Lions by more than 13.5 points in their December 19 matchup?\",\"description\":\"In the upcoming NFL game, scheduled for December 19:\\n\\nIf the Arizona Cardinals win by over 13.5 points, the market will resolve to “Yes”.\\n\\nIf the Detroit Lions lose by less than 13.5 points or win, the market will resolve “No.” \\n\\nIf the game is not completed by December 26, 2021, the market will resolve 50-50.\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-12-17T00:00:00Z\",\"creationDate\":\"2021-12-16T00:00:00Z\",\"endDate\":\"2021-12-19T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/nfl-will-the-cardinals-beat-the-lions-by-more-than-135-points-in-their-december-19-matchup-82971a59-e134-4d88-b336-25cac83a3b43.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/nfl-will-the-cardinals-beat-the-lions-by-more-than-135-points-in-their-december-19-matchup-82971a59-e134-4d88-b336-25cac83a3b43.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":935.89,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:09.336+00\",\"createdAt\":\"2022-07-27T14:40:09.339Z\",\"updatedAt\":\"2024-04-25T19:32:55.366923Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:09.339Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"3059\",\"ticker\":\"patriots-3-v-dolphins-spread\",\"slug\":\"patriots-3-v-dolphins-spread\",\"title\":\"Patriots (-3) v. Dolphins Spread\",\"description\":\"This is a market on whether the New England Patriots will cover a 3 point spread against the Miami Dolphins in their NFL week 1 matchup scheduled to take place on September 12, 2021. This market will resolve to “Patriots” if the Patriots win by over 3 points, and “Dolphins” if the Dolphins lose by less than 3 points or win. If the final point spread is exactly 3 points and favors the Patriots, the market will resolve 50-50 If the match is postponed to a date on or before October 12, 2021, the same market conditions will apply. If the match is postponed to a date after October 12, 2021, or canceled altogether, the market will resolve 50-50.\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-09-09T00:00:00Z\",\"creationDate\":\"2021-09-09T00:00:00Z\",\"endDate\":\"2021-09-12T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/patriots-3-v-dolphins-spread-a6433ec9-e643-40d3-8b13-7c8c7ccbcb38.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/patriots-3-v-dolphins-spread-a6433ec9-e643-40d3-8b13-7c8c7ccbcb38.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":5182.59,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:09.519+00\",\"createdAt\":\"2022-07-27T14:40:09.523Z\",\"updatedAt\":\"2024-04-22T21:22:42.796756Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"liquidityAmm\":0,\"liquidityClob\":0,\"commentCount\":3787,\"tags\":[{\"id\":\"100215\",\"label\":\"All\",\"slug\":\"all\",\"forceShow\":false,\"updatedAt\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:09.523Z\",\"showAllOutcomes\":false,\"showMarketI