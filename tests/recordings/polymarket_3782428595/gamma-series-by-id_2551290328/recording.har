At\":\"2026-04-17T20:23:54.340488Z\",\"requiresTranslation\":false}],\"cyom\":false,\"closedTime\":\"2022-07-27T14:40:09.882Z\",\"showAllOutcomes\":false,\"showMarketImages\":true,\"enableNegRisk\":false,\"seriesSlug\":\"nfl\",\"negRiskAugmented\":false,\"pendingDeployment\":false,\"deploying\":false,\"requiresTranslation\":false},{\"id\":\"3088\",\"ticker\":\"patriots-6-v-jets-spread\",\"slug\":\"patriots-6-v-jets-spread\",\"title\":\"Patriots (-6) v. Jets Spread\",\"description\":\"This is a market on whether the New England Patriots will cover a 6 point spread against the New York Jets in their NFL week two matchup scheduled to take place on September 19, 2021. This market will resolve to “Patriots” if the Patriots win by over 6 points, and “Jets” if the Jets lose by less than 6 points or win. If the final point spread is exactly 6 points and favors the Patriots, the market will resolve 50-50. If the match is postponed to a date on or before October 19, 2021, the same market conditions will apply. If the match is postponed to a date after October 19, 2021, or canceled altogether, the market will resolve 50-50.\",\"resolutionSource\":\"https://www.nfl.com/scores/\",\"startDate\":\"2021-09-17T00:00:00Z\",\"creationDate\":\"2021-09-17T00:00:00Z\",\"endDate\":\"2021-09-19T00:00:00Z\",\"image\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/patriots-6-v-jets-spread-063f50a7-9cd5-4dcf-8d7c-ef7fc3dac789.png\",\"icon\":\"https://polymarket-upload.s3.us-east-2.amazonaws.com/patriots-6-v-jets-spread-063f50a7-9cd5-4dcf-8d7c-ef7fc3dac789.png\",\"active\":true,\"closed\":true,\"archived\":false,\"new\":false,\"featured\":false,\"restricted\":false,\"liquidity\":0,\"volume\":2428.44,\"openInterest\":0,\"sortBy\":\"ascending\",\"category\":\"Sports\",\"published_at\":\"2022-07-27 14:40:10.645+00\",\"createdAt\":\"2022-07-27T14:40:10.648Z\",\"updatedAt\":\"2024-04-23T22:46:24.014542Z\",\"competitive\":0,\"volume24hr\":0,\"volume1wk\":0,\"volume1mo\":0,\"volume1yr\":0,\"l